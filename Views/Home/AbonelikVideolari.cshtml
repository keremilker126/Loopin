@model List<Loopin.Models.Video>

@{
    ViewData["Title"] = "Abonelikler";
    var abonelikler = ViewBag.Abonelikler as List<Abonelik>;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<style>

    :root{
        --purple:#8b5cf6;
        --purple2:#6d28d9;
        --pink:#ec4899;
        --bg:#070710;
        --card:rgba(255,255,255,0.05);
        --border:rgba(255,255,255,0.08);
        --muted:#9ca3af;
        --text:#ffffff;
    }

    /* PAGE */

    .subs-page{
        position:relative;
        overflow:hidden;

        animation:fadeIn .45s ease;
    }

    @@keyframes fadeIn{
        from{
            opacity:0;
            transform:translateY(10px);
        }

        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .subs-page::before{
        content:"";
        position:fixed;

        width:700px;
        height:700px;

        top:-250px;
        right:-250px;

        background:
            radial-gradient(rgba(139,92,246,0.12),
            transparent 70%);

        pointer-events:none;
    }

    .subs-page::after{
        content:"";
        position:fixed;

        width:650px;
        height:650px;

        bottom:-250px;
        left:-250px;

        background:
            radial-gradient(rgba(236,72,153,0.10),
            transparent 70%);

        pointer-events:none;
    }

    /* HERO */

    .subs-hero{
        position:relative;
        overflow:hidden;

        padding:42px;

        border-radius:36px;

        margin-bottom:38px;

        background:
            radial-gradient(circle at top left,
            rgba(139,92,246,0.18),
            transparent 35%),

            radial-gradient(circle at bottom right,
            rgba(236,72,153,0.14),
            transparent 35%),

            rgba(255,255,255,0.05);

        border:1px solid rgba(255,255,255,0.08);

        backdrop-filter:blur(24px);

        box-shadow:
            0 25px 60px rgba(0,0,0,0.35),
            inset 0 1px 0 rgba(255,255,255,0.03);
    }

    .hero-badge{
        display:inline-flex;
        align-items:center;
        gap:10px;

        padding:10px 18px;

        border-radius:999px;

        background:rgba(255,255,255,0.06);

        border:1px solid rgba(255,255,255,0.08);

        color:#ddd6fe;

        font-size:13px;
        font-weight:700;

        margin-bottom:18px;
    }

    .hero-title{
        font-size:52px;
        font-weight:900;

        line-height:1.05;

        margin-bottom:14px;

        letter-spacing:-1px;
    }

    .hero-title span{
        background:
            linear-gradient(135deg,
            #ffffff,
            #c4b5fd,
            #ec4899);

        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .hero-subtitle{
        max-width:720px;

        color:var(--muted);

        line-height:1.8;

        font-size:15px;
    }

    /* GRID */

    .subs-grid{
        display:grid;
        grid-template-columns:340px 1fr;
        gap:28px;
        align-items:start;
    }

    /* PANEL */

    .glass-panel{
        background:rgba(255,255,255,0.05);

        border:1px solid rgba(255,255,255,0.08);

        border-radius:30px;

        backdrop-filter:blur(24px);

        box-shadow:
            0 18px 40px rgba(0,0,0,0.28);

        overflow:hidden;
    }

    .panel-header{
        padding:24px 24px 18px 24px;

        border-bottom:1px solid rgba(255,255,255,0.06);
    }

    .panel-title{
        font-size:24px;
        font-weight:800;

        display:flex;
        align-items:center;
        gap:12px;
    }

    .panel-title i{
        color:#a855f7;
    }

    .panel-subtitle{
        margin-top:8px;

        color:var(--muted);

        font-size:13px;
        line-height:1.7;
    }

    /* USER LIST */

    .subs-users{
        padding:22px;
    }

    .user-item{
        display:flex;
        justify-content:space-between;
        align-items:center;

        gap:14px;

        padding:16px;

        border-radius:24px;

        background:rgba(255,255,255,0.04);

        border:1px solid rgba(255,255,255,0.06);

        margin-bottom:14px;

        transition:.28s ease;
    }

    .user-item:hover{
        transform:translateY(-4px);

        border-color:rgba(139,92,246,0.25);

        background:rgba(255,255,255,0.06);

        box-shadow:
            0 20px 35px rgba(0,0,0,0.25);
    }

    .user-left{
        display:flex;
        align-items:center;
        gap:14px;

        min-width:0;
    }

    .user-avatar{
        width:58px;
        height:58px;

        border-radius:20px;

        background:
            linear-gradient(135deg,
            var(--purple),
            var(--pink));

        display:flex;
        align-items:center;
        justify-content:center;

        color:white;

        font-size:22px;

        flex-shrink:0;

        box-shadow:
            0 15px 35px rgba(139,92,246,0.35);
    }

    .user-info{
        min-width:0;
    }

    .user-name{
        color:white;

        font-size:15px;
        font-weight:700;

        text-decoration:none;

        display:block;

        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
    }

    .user-name:hover{
        color:#c4b5fd;
    }

    .user-sub{
        color:var(--muted);
        font-size:12px;
        margin-top:4px;
    }

    .btn-unsub{
        border:none;

        border-radius:16px;

        padding:12px 16px;

        background:rgba(239,68,68,0.12);

        border:1px solid rgba(239,68,68,0.18);

        color:#fca5a5;

        font-size:12px;
        font-weight:700;

        transition:.25s ease;
    }

    .btn-unsub:hover{
        background:rgba(239,68,68,0.18);

        transform:translateY(-2px);
    }

    /* VIDEO AREA */

    .videos-header{
        display:flex;
        justify-content:space-between;
        align-items:center;

        margin-bottom:24px;

        flex-wrap:wrap;

        gap:16px;
    }

    .videos-title{
        font-size:30px;
        font-weight:900;

        display:flex;
        align-items:center;
        gap:12px;
    }

    .videos-title i{
        color:#ec4899;
    }

    .videos-sub{
        margin-top:6px;

        color:var(--muted);
        font-size:14px;
    }

    /* VIDEOS GRID */

    .videos-grid{
        display:grid;
        grid-template-columns:
            repeat(auto-fill,minmax(320px,1fr));

        gap:28px;
    }

    /* VIDEO CARD */

    .video-card-modern{
        position:relative;
        overflow:hidden;

        border-radius:30px;

        background:rgba(255,255,255,0.05);

        border:1px solid rgba(255,255,255,0.08);

        backdrop-filter:blur(24px);

        transition:.35s ease;

        box-shadow:
            0 18px 40px rgba(0,0,0,0.28);
    }

    .video-card-modern:hover{
        transform:translateY(-10px);

        border-color:rgba(139,92,246,0.3);

        box-shadow:
            0 35px 70px rgba(0,0,0,0.5),
            0 0 40px rgba(139,92,246,0.14);
    }

    /* VIDEO */

    .video-preview-wrapper{
        position:relative;
        overflow:hidden;
        height:220px;
    }

    .video-preview{
        width:100%;
        height:100%;
        object-fit:cover;

        transition:.5s ease;

        background:black;
    }

    .video-card-modern:hover .video-preview{
        transform:scale(1.08);
    }

    /* OVERLAY */

    .video-overlay{
        position:absolute;
        inset:0;

        background:
            linear-gradient(to top,
            rgba(0,0,0,0.78),
            rgba(0,0,0,0.08));

        display:flex;
        justify-content:center;
        align-items:center;

        opacity:0;

        transition:.3s ease;
    }

    .video-card-modern:hover .video-overlay{
        opacity:1;
    }

    .play-btn{
        width:84px;
        height:84px;

        border-radius:50%;

        display:flex;
        align-items:center;
        justify-content:center;

        background:rgba(255,255,255,0.14);

        border:1px solid rgba(255,255,255,0.18);

        backdrop-filter:blur(14px);

        color:white;

        font-size:28px;

        transition:.3s ease;
    }

    .video-card-modern:hover .play-btn{
        transform:scale(1.08);
    }

    /* BADGE */

    .video-badge{
        position:absolute;

        top:14px;
        left:14px;

        z-index:5;

        padding:8px 14px;

        border-radius:999px;

        background:
            linear-gradient(135deg,
            var(--purple),
            var(--pink));

        color:white;

        font-size:11px;
        font-weight:800;

        box-shadow:
            0 12px 25px rgba(139,92,246,0.3);
    }

    /* CONTENT */

    .video-content{
        padding:24px;
    }

    .video-title{
        font-size:20px;
        font-weight:800;

        line-height:1.4;

        margin-bottom:10px;
    }

    .video-desc{
        color:var(--muted);

        font-size:14px;

        line-height:1.7;

        height:48px;

        overflow:hidden;

        margin-bottom:22px;
    }

    /* META */

    .video-meta{
        display:flex;
        justify-content:space-between;
        align-items:center;

        gap:14px;

        margin-bottom:24px;

        flex-wrap:wrap;
    }

    .meta-user{
        display:flex;
        align-items:center;
        gap:12px;
    }

    .meta-avatar{
        width:48px;
        height:48px;

        border-radius:16px;

        background:
            linear-gradient(135deg,
            var(--purple),
            var(--pink));

        display:flex;
        align-items:center;
        justify-content:center;

        color:white;

        font-size:18px;

        box-shadow:
            0 12px 28px rgba(139,92,246,0.28);
    }

    .meta-title{
        color:white;

        font-size:13px;
        font-weight:700;

        text-decoration:none;
    }

    .meta-title:hover{
        color:#ddd6fe;
    }

    .meta-sub{
        font-size:12px;
        color:#8f94aa;

        margin-top:3px;
    }

    .stats{
        display:flex;
        align-items:center;
        gap:12px;

        font-size:13px;
        color:#d7dae7;
    }

    /* BUTTON */

    .btn-watch{
        width:100%;

        border:none;

        border-radius:18px;

        padding:15px;

        background:
            linear-gradient(135deg,
            var(--purple),
            var(--pink));

        color:white;

        text-decoration:none;

        font-size:14px;
        font-weight:700;

        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;

        transition:.25s ease;

        box-shadow:
            0 15px 35px rgba(139,92,246,0.28);
    }

    .btn-watch:hover{
        color:white;

        transform:translateY(-2px);

        box-shadow:
            0 20px 40px rgba(139,92,246,0.42);
    }

    /* EMPTY */

    .empty-box{
        text-align:center;

        padding:42px 28px;

        border-radius:26px;

        background:rgba(255,255,255,0.04);

        border:1px dashed rgba(255,255,255,0.08);

        color:var(--muted);
    }

    .empty-icon{
        width:90px;
        height:90px;

        border-radius:24px;

        margin:auto;
        margin-bottom:20px;

        display:flex;
        align-items:center;
        justify-content:center;

        background:
            linear-gradient(135deg,
            var(--purple),
            var(--pink));

        color:white;

        font-size:36px;

        box-shadow:
            0 18px 40px rgba(139,92,246,0.3);
    }

    .empty-title{
        font-size:26px;
        font-weight:900;

        margin-bottom:10px;

        background:
            linear-gradient(135deg,
            #ffffff,
            #c4b5fd,
            #ec4899);

        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .empty-text{
        line-height:1.8;
        color:var(--muted);
    }

    /* MOBILE */

    @@media(max-width:1100px){

        .subs-grid{
            grid-template-columns:1fr;
        }
    }

    @@media(max-width:768px){

        .subs-hero{
            padding:28px;
            border-radius:28px;
        }

        .hero-title{
            font-size:38px;
        }

        .videos-grid{
            grid-template-columns:1fr;
        }

        .user-item{
            flex-direction:column;
            align-items:flex-start;
        }

        .btn-unsub{
            width:100%;
        }
    }

</style>

<div class="subs-page">

    <!-- HERO -->
    <div class="subs-hero">

        <div class="hero-badge">
            <i class="fa-solid fa-bell"></i>
            Takip Ettiğin İçerikler
        </div>

        <div class="hero-title">
            Abonelik <span>Akışın</span>
        </div>

        <div class="hero-subtitle">
            Takip ettiğin kullanıcıların en yeni videolarını tek yerde keşfet.
        </div>

    </div>

    <!-- GRID -->
    <div class="subs-grid">

        <!-- LEFT -->
        <div class="glass-panel">

            <div class="panel-header">

                <div class="panel-title">
                    <i class="fa-solid fa-users"></i>
                    Abonelikler
                </div>

                <div class="panel-subtitle">
                    Takip ettiğin içerik üreticileri burada görüntülenir.
                </div>

            </div>

            <div class="subs-users">

                @if (abonelikler == null || !abonelikler.Any())
                {
                    <div class="empty-box">

                        <div class="empty-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>

                        <div class="empty-title">
                            Henüz Abonelik Yok
                        </div>

                        <div class="empty-text">
                            Kullanıcılara abone olduğunda burada görünürler.
                        </div>

                    </div>
                }
                else
                {
                    @foreach (var abone in abonelikler)
                    {
                        <div class="user-item">

                            <div class="user-left">

                                <div class="user-avatar">
                                    <i class="fa-solid fa-user"></i>
                                </div>

                                <div class="user-info">

                                    <a asp-controller="Home"
                                       asp-action="Kullanici"
                                       asp-route-id="@abone.AboneOlunanId"
                                       class="user-name">

                                        @abone.AboneOlunan.KullaniciAdi

                                    </a>

                                    <div class="user-sub">
                                        İçerik üreticisi
                                    </div>

                                </div>

                            </div>

                            <form asp-controller="Home"
                                  asp-action="AbonelikToggle"
                                  asp-route-id="@abone.AboneOlunanId"
                                  method="post">

                                <button class="btn-unsub">

                                    <i class="fa-solid fa-user-minus"></i>
                                    Çık

                                </button>

                            </form>

                        </div>
                    }
                }

            </div>

        </div>

        <!-- RIGHT -->
        <div>

            <div class="videos-header">

                <div>

                    <div class="videos-title">
                        <i class="fa-solid fa-photo-film"></i>
                        Abonelik Videoları
                    </div>

                    <div class="videos-sub">
                        Takip ettiğin kullanıcıların en yeni içerikleri
                    </div>

                </div>

            </div>

            @if (!Model.Any())
            {
                <div class="glass-panel p-4">

                    <div class="empty-box">

                        <div class="empty-icon">
                            <i class="fa-solid fa-video"></i>
                        </div>

                        <div class="empty-title">
                            Henüz Video Yok
                        </div>

                        <div class="empty-text">
                            Abone olduğun kullanıcılar video yüklediğinde burada görünür.
                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="videos-grid">

                    @foreach (var video in Model)
                    {
                        <div class="video-card-modern">

                            <!-- VIDEO -->
                            <div class="video-preview-wrapper">

                                <div class="video-badge">
                                    📺 ABONELİK
                                </div>

                                <video class="video-preview"
                                       muted
                                       preload="metadata">

                                    <source src="@video.VideoUrl"
                                            type="video/mp4" />

                                </video>

                                <!-- OVERLAY -->
                                <div class="video-overlay">

                                    <div class="play-btn">
                                        <i class="fa-solid fa-play"></i>
                                    </div>

                                </div>

                            </div>

                            <!-- CONTENT -->
                            <div class="video-content">

                                <div class="video-title">
                                    @video.Baslik
                                </div>

                                <div class="video-desc">
                                    @video.Aciklama
                                </div>

                                <!-- META -->
                                <div class="video-meta">

                                    <div class="meta-user">

                                        <div class="meta-avatar">
                                            <i class="fa-solid fa-user"></i>
                                        </div>

                                        <div>

                                            <a asp-controller="Home"
                                               asp-action="Kullanici"
                                               asp-route-id="@video.KullaniciId"
                                               class="meta-title">

                                                @video.Kullanici?.KullaniciAdi

                                            </a>

                                            <div class="meta-sub">
                                                @video.YuklenmeTarihi.ToString("dd MMM yyyy")
                                            </div>

                                        </div>

                                    </div>

                                    <div class="stats">
                                        <span>👁 @video.IzlenmeSayisi</span>
                                        <span>👍 @video.LikeSayisi</span>
                                    </div>

                                </div>

                                <!-- BUTTON -->
                                <a asp-controller="Home"
                                   asp-action="Izle"
                                   asp-route-id="@video.Id"
                                   class="btn-watch">

                                    <i class="fa-solid fa-play"></i>
                                    İzle

                                </a>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>