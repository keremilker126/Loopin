@{
    ViewData["Title"] = "Kod Doğrulama";
}

<style>

    :root{
        --purple:#7c5cff;
        --purple2:#b14dff;
        --bg:#070710;
        --card:rgba(255,255,255,0.06);
        --border:rgba(255,255,255,0.08);
        --text:#ffffff;
        --muted:#acacd0;
    }

    body {

        min-height: 100vh;
        margin: 0;
        overflow-x:hidden;

        background:
            radial-gradient(circle at top left, rgba(124,92,255,0.20), transparent 30%),
            radial-gradient(circle at bottom right, rgba(177,77,255,0.18), transparent 30%),
            linear-gradient(160deg,#05050c,#0d0e1c 55%,#090912);

        position:relative;
    }

    body::before{
        content:"";
        position:fixed;
        inset:0;

        background-image:
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);

        background-size:40px 40px;

        pointer-events:none;
        z-index:-1;
    }

    /* WRAPPER */

    .auth-wrapper {

        display: flex;
        justify-content: center;
        align-items: flex-start;

        padding-top: 90px;
        padding-bottom:40px;

        min-height: 100vh;

        position:relative;
    }

    .auth-wrapper::before{

        content:"";
        position:absolute;

        width:500px;
        height:500px;

        background:
            radial-gradient(circle,
            rgba(124,92,255,0.22),
            transparent 70%);

        top:-180px;

        filter: blur(20px);

        z-index:0;
    }

    /* CARD */

    .auth-container {

        width: 100%;
        max-width: 430px;

        padding: 38px;

        border-radius: 34px;

        position:relative;
        overflow:hidden;
        z-index:2;

        background:
            linear-gradient(
                145deg,
                rgba(255,255,255,0.07),
                rgba(255,255,255,0.03)
            );

        backdrop-filter: blur(28px);

        border:1px solid rgba(255,255,255,0.08);

        box-shadow:
            0 25px 70px rgba(0,0,0,0.45),
            0 0 40px rgba(124,92,255,0.10),
            inset 0 1px 0 rgba(255,255,255,0.04);

        transition:.35s ease;

        animation: cardShow .5s ease;
    }

    .auth-container::before{
        content:"";
        position:absolute;
        inset:0;

        background:
            linear-gradient(
                135deg,
                rgba(124,92,255,0.10),
                transparent 35%,
                rgba(177,77,255,0.08)
            );

        pointer-events:none;
    }

    .auth-container:hover {
        transform: translateY(-8px);

        box-shadow:
            0 35px 80px rgba(0,0,0,0.50),
            0 0 50px rgba(124,92,255,0.18);
    }

    @@keyframes cardShow{

        from{
            opacity:0;
            transform:translateY(18px) scale(.98);
        }

        to{
            opacity:1;
            transform:translateY(0) scale(1);
        }
    }

    /* HEADER */

    .verify-icon{

        width:84px;
        height:84px;

        margin:0 auto 24px;

        border-radius:28px;

        background:
            linear-gradient(
                135deg,
                var(--purple),
                var(--purple2)
            );

        display:flex;
        align-items:center;
        justify-content:center;

        font-size:34px;
        color:white;

        box-shadow:
            0 14px 35px rgba(124,92,255,0.45),
            0 0 30px rgba(177,77,255,0.28);

        animation: floaty 3s ease-in-out infinite;
    }

    @@keyframes floaty{

        0%{
            transform:translateY(0px);
        }

        50%{
            transform:translateY(-6px);
        }

        100%{
            transform:translateY(0px);
        }
    }

    .auth-title {

        text-align: center;

        margin-bottom: 8px;

        font-weight: 800;

        font-size: 34px;

        color: white;

        letter-spacing:-1px;
    }

    .auth-subtitle{
        text-align:center;
        color:var(--muted);
        margin-bottom:32px;
        font-size:14px;
        line-height:1.6;
    }

    /* FORM */

    label {

        margin-bottom: 8px;

        font-size: 13px;

        color: #d0d0e7;

        font-weight: 600;

        display:block;

        letter-spacing:.3px;
    }

    .form-control {

        border-radius: 22px;

        background: rgba(255,255,255,0.05) !important;

        border: 1px solid rgba(255,255,255,0.08);

        color: white !important;

        padding: 18px;

        text-align: center;

        letter-spacing: 10px;

        font-size: 24px;

        font-weight:700;

        transition: .28s ease;

        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.03);
    }

    .form-control::placeholder{
        color:#9d9dc0;
        letter-spacing:8px;
    }

    .form-control:hover{
        border-color: rgba(124,92,255,0.25);
    }

    .form-control:focus {

        box-shadow:
            0 0 0 4px rgba(124,92,255,0.14),
            0 0 30px rgba(124,92,255,0.18);

        background: rgba(255,255,255,0.07) !important;

        border-color: rgba(124,92,255,0.7);

        color: white !important;
    }

    /* BUTTON */

    .btn-auth {

        background:
            linear-gradient(
                135deg,
                var(--purple),
                var(--purple2)
            );

        border: none;

        width: 100%;

        padding: 16px;

        border-radius: 22px;

        color: white;

        font-weight: 700;

        font-size: 15px;

        letter-spacing:.4px;

        transition: .28s ease;

        margin-top:8px;

        box-shadow:
            0 15px 35px rgba(124,92,255,0.35);
    }

    .btn-auth:hover {

        transform: translateY(-3px) scale(1.01);

        box-shadow:
            0 20px 40px rgba(124,92,255,0.50);
    }

    .btn-auth:active{
        transform:scale(.99);
    }

    /* MESSAGE */

    .message {

        text-align: center;

        padding: 16px 18px;

        border-radius: 18px;

        margin-top: 18px;

        font-size: 14px;

        font-weight:500;

        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;

        border:1px solid rgba(255,255,255,0.06);

        animation: fadeIn .4s ease;
    }

    .error {

        background:
            linear-gradient(
                135deg,
                rgba(255,77,77,0.22),
                rgba(122,0,0,0.18)
            );

        color: #ffe1e1;

        border-left:4px solid #ff4d4d;

        box-shadow:
            0 10px 30px rgba(255,77,77,0.12);
    }

    @@keyframes fadeIn {

        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* MOBILE */

    @@media(max-width:576px){

        .auth-wrapper{
            padding:20px;
            padding-top:40px;
        }

        .auth-container{
            padding:28px 22px;
            border-radius:28px;
        }

        .auth-title{
            font-size:28px;
        }

        .form-control{
            font-size:20px;
            letter-spacing:6px;
        }

    }

</style>

<div class="auth-wrapper">

    <div class="auth-container">

        <div class="verify-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <h2 class="auth-title">
            Kod Doğrulama
        </h2>

        <div class="auth-subtitle">
            E-posta adresine gönderilen 6 haneli doğrulama kodunu gir
        </div>

        <form method="post">

            <input type="hidden"
                   name="email"
                   value="@ViewBag.Email" />

            <div class="mb-3">

                <label>Doğrulama Kodu</label>

                <input type="text"
                       name="code"
                       class="form-control"
                       placeholder="••••••"
                       maxlength="6"
                       required />

            </div>

            <div class="mb-3">

                <label>Güvenlik Kodu (@ViewBag.SecurityQuestion)</label>

                <input type="text"
                       name="GuvenlikKodu"
                       class="form-control"
                       placeholder="Sonuc"
                       inputmode="numeric"
                       required />

            </div>

            <button type="submit" class="btn-auth">
                <i class="fa-solid fa-circle-check"></i>
                Doğrula
            </button>

        </form>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="message error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

    </div>

</div>
