@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<style>

    body {
        min-height: 100vh;
        margin: 0;
        overflow-x: hidden;
        font-family: 'Inter', sans-serif;
        background:
            radial-gradient(circle at top left, rgba(124,92,255,0.22), transparent 28%),
            radial-gradient(circle at bottom right, rgba(177,77,255,0.18), transparent 30%),
            linear-gradient(160deg, #05050c, #0d0e1c 50%, #090912);
        position: relative;
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 42px 42px;
        pointer-events: none;
        z-index: -2;
    }

    body::after {
        content: "";
        position: fixed;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(124,92,255,0.22), transparent 70%);
        top: -180px;
        right: -120px;
        filter: blur(60px);
        z-index: -1;
        animation: glowMove 10s ease-in-out infinite alternate;
    }

    @@keyframes glowMove {
        from {
            transform: translateY(0px) translateX(0px);
        }

        to {
            transform: translateY(30px) translateX(-20px);
        }
    }

    .auth-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 85px;
        min-height: 100vh;
        position: relative;
    }

    .auth-container {
        width: 100%;
        max-width: 440px;
        padding: 38px;
        border-radius: 34px;
        position: relative;
        overflow: hidden;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(28px);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow:
            0 30px 80px rgba(0,0,0,0.55),
            inset 0 1px 0 rgba(255,255,255,0.05);
        color: white;
        transition: 0.35s ease;
        animation: fadeUp 0.7s ease;
    }

    .auth-container::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(135deg,
            rgba(124,92,255,0.18),
            rgba(177,77,255,0.08),
            transparent 70%);
        pointer-events: none;
    }

    .auth-container:hover {
        transform: translateY(-8px);
        box-shadow:
            0 40px 90px rgba(0,0,0,0.7),
            0 0 45px rgba(124,92,255,0.18);
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .auth-header {
        text-align: center;
        margin-bottom: 30px;
        position: relative;
        z-index: 2;
    }

    .icon-box {
        width: 90px;
        height: 90px;
        margin: 0 auto 20px;
        border-radius: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            linear-gradient(135deg,
            rgba(124,92,255,0.95),
            rgba(177,77,255,0.95));
        box-shadow:
            0 20px 45px rgba(124,92,255,0.45),
            inset 0 1px 0 rgba(255,255,255,0.25);
        font-size: 38px;
        animation: floatIcon 3s ease-in-out infinite;
    }

    @@keyframes floatIcon {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-6px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .auth-title {
        font-size: 31px;
        font-weight: 800;
        margin-bottom: 10px;
        background: linear-gradient(90deg, #ffffff, #d8ccff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: 0.4px;
    }

    .auth-subtitle {
        color: #b8b8d8;
        font-size: 14px;
        line-height: 1.7;
        max-width: 320px;
        margin: auto;
    }

    form {
        position: relative;
        z-index: 2;
    }

    .input-group-modern {
        margin-bottom: 22px;
    }

    label {
        margin-bottom: 8px;
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #d8d8ee;
        letter-spacing: 0.3px;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #a78bfa;
        font-size: 15px;
        pointer-events: none;
    }

    .form-control {
        width: 100%;
        border-radius: 20px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        color: white;
        padding: 16px 18px 16px 48px;
        font-size: 15px;
        transition: 0.25s ease;
        backdrop-filter: blur(10px);
        box-shadow: inset 0 0 0 rgba(124,92,255,0);
    }

    .form-control::placeholder {
        color: #8e8eb0;
    }

    .form-control:focus {
        outline: none;
        border-color: rgba(124,92,255,0.65);
        background: rgba(255,255,255,0.08);
        color: white;
        box-shadow:
            0 0 0 4px rgba(124,92,255,0.14),
            0 0 35px rgba(124,92,255,0.18);
    }

    .btn-auth {
        width: 100%;
        border: none;
        border-radius: 22px;
        padding: 16px;
        color: white;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #7c5cff, #b14dff);
        box-shadow:
            0 18px 40px rgba(124,92,255,0.35),
            inset 0 1px 0 rgba(255,255,255,0.2);
        transition: 0.3s ease;
    }

    .btn-auth::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            120deg,
            transparent,
            rgba(255,255,255,0.18),
            transparent);
        transform: translateX(-120%);
        transition: 0.6s;
    }

    .btn-auth:hover::before {
        transform: translateX(120%);
    }

    .btn-auth:hover {
        transform: translateY(-3px) scale(1.01);
        box-shadow:
            0 25px 50px rgba(124,92,255,0.5),
            0 0 30px rgba(177,77,255,0.22);
    }

    .btn-auth:active {
        transform: scale(0.98);
    }

    .message {
        margin-top: 18px;
        padding: 15px 18px;
        border-radius: 18px;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,0.06);
        animation: fadeMessage 0.4s ease;
        position: relative;
        z-index: 2;
    }

    .message.error {
        background: linear-gradient(
            135deg,
            rgba(239,68,68,0.24),
            rgba(127,29,29,0.25));
        color: #ffd2d2;
        border-color: rgba(239,68,68,0.25);
        box-shadow: 0 10px 30px rgba(239,68,68,0.12);
    }

    .message.success {
        background: linear-gradient(
            135deg,
            rgba(74,222,128,0.18),
            rgba(34,197,94,0.15));
        color: #d1ffe2;
        border-color: rgba(74,222,128,0.2);
        box-shadow: 0 10px 30px rgba(74,222,128,0.12);
    }

    @@keyframes fadeMessage {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .bottom-note {
        text-align: center;
        margin-top: 22px;
        color: #9696b8;
        font-size: 13px;
        line-height: 1.7;
        position: relative;
        z-index: 2;
    }

    @@media(max-width: 576px) {

        .auth-wrapper {
            padding: 30px 16px;
        }

        .auth-container {
            padding: 30px 22px;
            border-radius: 28px;
        }

        .auth-title {
            font-size: 26px;
        }

        .icon-box {
            width: 76px;
            height: 76px;
            border-radius: 24px;
            font-size: 30px;
        }
    }

</style>

<div class="auth-wrapper">

    <div class="auth-container">

        <div class="auth-header">

            <div class="icon-box">
                🔑
            </div>

            <h2 class="auth-title">
                Şifremi Unuttum
            </h2>

            <div class="auth-subtitle">
                Hesabına bağlı e-posta adresini gir,
                sana doğrulama kodu gönderelim.
            </div>

        </div>

        <form method="post">

            <div class="input-group-modern">

                <label>E-posta Adresi</label>

                <div class="input-wrapper">

                    <span class="input-icon">
                        📧
                    </span>

                    <input type="email"
                           name="Email"
                           class="form-control"
                           placeholder="ornek@mail.com"
                           required />

                </div>

            </div>

            <div class="input-group-modern">

                <label>Güvenlik Kodu (@ViewBag.SecurityQuestion)</label>

                <div class="input-wrapper">

                    <span class="input-icon">=</span>

                    <input type="text"
                           name="GuvenlikKodu"
                           class="form-control"
                           placeholder="Sonucu yaz"
                           inputmode="numeric"
                           required />

                </div>

            </div>

            <button type="submit" class="btn-auth">
                📨 Kod Gönder
            </button>

        </form>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="message error">
                ❌ @ViewBag.ErrorMessage
            </div>
        }

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="message success">
                ✅ @ViewBag.SuccessMessage
            </div>
        }

        <div class="bottom-note">
            Güvenliğin için doğrulama kodu yalnızca
            kayıtlı e-posta adresine gönderilir.
        </div>

    </div>

</div>
