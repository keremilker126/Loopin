@model List<Video>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<style>

    :root {
        --purple: #7c5cff;
        --purple2: #b14dff;
        --dark: #0b0b14;
        --card: rgba(255,255,255,0.05);
        --border: rgba(255,255,255,0.08);
        --text: #ffffff;
        --muted: #a1a1c2;
    }

    .home-wrapper {
        animation: fadeIn 0.4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* HERO */

    .hero-box {
        position: relative;
        overflow: hidden;
        border-radius: 34px;
        padding: 42px;
        margin-bottom: 40px;
        background:
            radial-gradient(circle at top left,
            rgba(124,92,255,0.30),
            transparent 40%),
            radial-gradient(circle at bottom right,
            rgba(177,77,255,0.18),
            transparent 35%),
            rgba(255,255,255,0.05);

        border: 1px solid rgba(255,255,255,0.08);
        backdrop-filter: blur(24px);

        box-shadow:
            0 20px 50px rgba(0,0,0,0.35),
            inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .hero-box::before {
        content: "";
        position: absolute;
        width: 500px;
        height: 500px;
        background: radial-gradient(rgba(124,92,255,0.18), transparent 70%);
        top: -200px;
        right: -150px;
        pointer-events: none;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        border-radius: 999px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        color: #d5d5ff;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .hero-title {
        font-size: 46px;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 14px;
        letter-spacing: -1px;
    }

    .hero-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        position: relative;
        z-index: 2;
    }

    .hero-title span {
        background: linear-gradient(135deg, #ffffff, #bb9cff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        color: var(--muted);
        font-size: 15px;
        max-width: 700px;
        line-height: 1.8;
        position: relative;
        z-index: 2;
    }

    .btn-apk-download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 18px;
        border-radius: 18px;
        color: white;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        box-shadow: 0 14px 30px rgba(0,0,0,0.2);
        transition: 0.25s ease;
        white-space: nowrap;
    }

    .btn-apk-download:hover {
        color: white;
        transform: translateY(-2px);
        border-color: rgba(124,92,255,0.45);
        background: linear-gradient(135deg, var(--purple), var(--purple2));
        box-shadow: 0 18px 35px rgba(124,92,255,0.3);
    }

    .mobile-download-box {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 24px;
        margin-bottom: 28px;
        border-radius: 26px;
        background: linear-gradient(135deg, rgba(124,92,255,.16), rgba(177,77,255,.07));
        border: 1px solid rgba(124,92,255,.28);
    }

    .mobile-download-copy {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .mobile-download-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        color: white;
        font-size: 24px;
        background: linear-gradient(135deg, var(--purple), var(--purple2));
    }

    .mobile-download-title {
        margin: 0 0 4px;
        color: white;
        font-weight: 750;
        font-size: 18px;
    }

    .mobile-download-text {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }

    .download-alert {
        margin-bottom: 20px;
        padding: 14px 18px;
        border-radius: 16px;
        color: #fecaca;
        background: rgba(239,68,68,.12);
        border: 1px solid rgba(239,68,68,.28);
    }

    /* SECTION */

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 26px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .section-title {
        font-size: 28px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
    }

    .section-title i {
        color: #b14dff;
    }

    .section-subtitle {
        color: var(--muted);
        font-size: 14px;
        margin-top: 6px;
    }

    /* GRID */

    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 28px;
    }

    /* CARD */

    .video-card {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        backdrop-filter: blur(20px);
        transition: 0.35s ease;
        box-shadow:
            0 15px 35px rgba(0,0,0,0.25);
    }

    .video-card:hover {
        transform: translateY(-10px);
        border-color: rgba(124,92,255,0.35);
        box-shadow:
            0 30px 60px rgba(0,0,0,0.45),
            0 0 35px rgba(124,92,255,0.15);
    }

    /* THUMBNAIL */

    .thumbnail-wrapper {
        position: relative;
        overflow: hidden;
        height: 220px;
    }

    .video-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.5s ease;
    }

    .video-card:hover .video-img {
        transform: scale(1.08);
    }

    .thumbnail-overlay {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(to top,
            rgba(0,0,0,0.75),
            rgba(0,0,0,0.15));
        opacity: 0;
        transition: 0.35s ease;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .video-card:hover .thumbnail-overlay {
        opacity: 1;
    }

    .play-btn {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.18);
        font-size: 26px;
        color: white;
        transform: scale(0.8);
        transition: 0.3s ease;
    }

    .video-card:hover .play-btn {
        transform: scale(1);
    }

    /* TOP TAGS */

    .top-tags {
        position: absolute;
        top: 14px;
        left: 14px;
        right: 14px;
        display: flex;
        justify-content: space-between;
        z-index: 5;
    }

    .tag {
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .tag-new {
        background: rgba(124,92,255,0.22);
        color: #e8dfff;
    }

    .tag-views {
        background: rgba(0,0,0,0.35);
        color: white;
    }

    /* BODY */

    .video-content {
        padding: 22px;
    }

    .video-title {
        font-size: 18px;
        font-weight: 700;
        line-height: 1.4;
        margin-bottom: 10px;
        color: white;
    }

    .video-description {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
        height: 48px;
        overflow: hidden;
        margin-bottom: 16px;
    }

    /* META */

    .video-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .creator-box {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .creator-avatar {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--purple), var(--purple2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 15px;
        color: white;
        box-shadow: 0 10px 20px rgba(124,92,255,0.3);
    }

    .creator-name {
        font-size: 14px;
        font-weight: 600;
        color: white;
    }

    .creator-date {
        font-size: 12px;
        color: #8f8fb0;
    }

    .video-stats {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #bcbcdf;
        font-size: 13px;
    }

    /* BUTTONS */

    .video-actions {
        display: flex;
        gap: 12px;
    }

    .btn-modern {
        flex: 1;
        border: none;
        border-radius: 18px;
        padding: 14px;
        font-size: 14px;
        font-weight: 600;
        transition: 0.25s ease;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-watch {
        background: linear-gradient(135deg, var(--purple), var(--purple2));
        color: white;
        box-shadow: 0 12px 24px rgba(124,92,255,0.28);
    }

    .btn-watch:hover {
        transform: translateY(-2px);
        color: white;
        box-shadow: 0 18px 30px rgba(124,92,255,0.45);
    }

    .btn-save {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        color: white;
    }

    .btn-save:hover {
        background: rgba(255,255,255,0.10);
        transform: translateY(-2px);
    }

    /* EMPTY */

    .empty-state {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .empty-box {
        width: 100%;
        max-width: 700px;
        text-align: center;
        padding: 60px;
        border-radius: 36px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        backdrop-filter: blur(24px);
    }

    .empty-icon {
        width: 120px;
        height: 120px;
        border-radius: 30px;
        margin: auto;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--purple), var(--purple2));
        font-size: 42px;
        box-shadow: 0 20px 50px rgba(124,92,255,0.35);
    }

    .empty-title {
        font-size: 36px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .empty-text {
        color: var(--muted);
        margin-bottom: 26px;
        line-height: 1.8;
    }

    .btn-upload {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 24px;
        border-radius: 18px;
        background: linear-gradient(135deg, var(--purple), var(--purple2));
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: 0.25s ease;
        box-shadow: 0 15px 35px rgba(124,92,255,0.35);
    }

    .btn-upload:hover {
        transform: translateY(-3px);
        color: white;
    }

    /* MOBILE */

    @@media(max-width:768px) {

        .hero-box {
            padding: 28px;
        }

        .hero-title {
            font-size: 34px;
        }

        .hero-title-row {
            align-items: flex-start;
        }

        .mobile-download-box {
            flex-direction: column;
            align-items: flex-start;
        }

        .video-grid {
            grid-template-columns: 1fr;
        }

        .video-actions {
            flex-direction: column;
        }

        .empty-box {
            padding: 40px 24px;
        }
    }

</style>

<div class="home-wrapper">

    @if (TempData["DownloadError"] != null)
    {
        <div class="download-alert" role="alert">
            @TempData["DownloadError"]
        </div>
    }

    <div class="mobile-download-box">
        <div class="mobile-download-copy">
            <div class="mobile-download-icon">
                <i class="fa-brands fa-android"></i>
            </div>
            <div>
                <p class="mobile-download-title">Loopin Mobil Uygulamasi</p>
                <p class="mobile-download-text">Android telefonuna uygulamayi indir ve videolari mobilde izle.</p>
            </div>
        </div>

        <a asp-controller="Home"
           asp-action="MobilUygulamayiIndir"
           class="btn-apk-download">
            <i class="fa-solid fa-download"></i>
            Mobil Uygulamayi Indir
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-box">

                <div class="empty-icon">
                    <i class="fa-solid fa-video"></i>
                </div>

                <div class="empty-title">
                    Henüz Video Yok
                </div>

                <div class="empty-text">
                    Platformdaki ilk içeriği sen paylaş.
                    Topluluğu başlat ve kendi videolarını keşfetmeye aç 🚀
                </div>

                <a href="/Home/Yukle" class="btn-upload">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    İlk Videonu Yükle
                </a>

            </div>

        </div>
    }
    else
    {

        <!-- HERO -->
        <div class="hero-box">

            <div class="hero-badge">
                <i class="fa-solid fa-sparkles"></i>
                Loopin Sana Özel İçerikleri Hazırladı
            </div>

            <div class="hero-title-row">
                <div class="hero-title">
                    Hoş Geldin <span>👋</span>
                </div>

            </div>

            <div class="hero-subtitle">
                Trend videoları keşfet, içerik üreticilerini takip et
                ve modern video deneyimini yaşa.
            </div>

        </div>

        <!-- SECTION -->
        <div class="section-header">

            <div>
                <h2 class="section-title">
                    <i class="fa-solid fa-fire"></i>
                    En Yeni Videolar
                </h2>

                <div class="section-subtitle">
                    Platformdaki en güncel içerikler burada listeleniyor
                </div>
            </div>

        </div>

        <!-- GRID -->
        <div class="video-grid">

            @foreach (var video in Model)
            {
                <div class="video-card">

                    <!-- THUMB -->
                    <div class="thumbnail-wrapper">

                        <img src="@video.KapakResmiUrl"
                             class="video-img"
                             alt="@video.Baslik" />

                        <!-- TAGS -->
                        <div class="top-tags">

                            <div class="tag tag-new">
                                Yeni
                            </div>

                            <div class="tag tag-views">
                                👁 @video.IzlenmeSayisi
                            </div>

                        </div>

                        <!-- OVERLAY -->
                        <div class="thumbnail-overlay">

                            <div class="play-btn">
                                <i class="fa-solid fa-play"></i>
                            </div>

                        </div>

                    </div>

                    <!-- CONTENT -->
                    <div class="video-content">

                        <div class="video-title">
                            @video.Baslik
                        </div>

                        <div class="video-description">
                            @video.Aciklama
                        </div>

                        <!-- META -->
                        <div class="video-meta">

                            <div class="creator-box">

                                <div class="creator-avatar">
                                    @(string.IsNullOrWhiteSpace(video.Kullanici?.KullaniciAdi)
                                        ? "?"
                                        : video.Kullanici!.KullaniciAdi!.Substring(0, 1).ToUpper())
                                </div>

                                <div>

                                    <div class="creator-name">
                                        @video.Kullanici?.KullaniciAdi
                                    </div>

                                    <div class="creator-date">
                                        @video.YuklenmeTarihi.ToString("dd MMM yyyy")
                                    </div>

                                </div>

                            </div>

                            <div class="video-stats">
                                <span>👍 @video.LikeSayisi</span>
                            </div>

                        </div>

                        <!-- ACTIONS -->
                        <div class="video-actions">

                            <!-- WATCH -->
                            <a asp-controller="Home"
                               asp-action="Izle"
                               asp-route-id="@video.Id"
                               class="btn-modern btn-watch">

                                <i class="fa-solid fa-play"></i>
                                İzle

                            </a>

                            <!-- SAVE -->
                            <form asp-controller="Home"
                                  asp-action="DahaSonraEkle"
                                  asp-route-id="@video.Id"
                                  method="post"
                                  style="flex:1;">

                                <button class="btn-modern btn-save w-100">

                                    <i class="fa-regular fa-bookmark"></i>
                                    Kaydet

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
