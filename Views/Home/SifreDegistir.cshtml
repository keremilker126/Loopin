@{
    ViewData["Title"] = "Şifre Değiştir";
}

<style>

    :root{
        --purple:#7c5cff;
        --purple2:#b14dff;
        --bg:#070710;
        --card:rgba(255,255,255,0.06);
        --border:rgba(255,255,255,0.08);
        --text:#ffffff;
        --muted:#a8a8c7;
        --success:#22c55e;
        --danger:#ef4444;
    }

    body {

        min-height:100vh;
        margin:0;
        overflow-x:hidden;

        background:
            radial-gradient(circle at top left, rgba(124,92,255,0.22), transparent 30%),
            radial-gradient(circle at bottom right, rgba(177,77,255,0.18), transparent 30%),
            linear-gradient(160deg,#05050c,#0d0e1c 55%,#090912);

        font-family:'Inter',sans-serif;

        position:relative;
    }

    body::before{
        content:"";
        position:fixed;
        inset:0;

        background-image:
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);

        background-size:40px 40px;

        pointer-events:none;
        z-index:-1;
    }

    body::after{
        content:"";
        position:fixed;

        width:500px;
        height:500px;

        background:
            radial-gradient(circle,
                rgba(124,92,255,0.18),
                transparent 70%);

        top:-180px;
        right:-120px;

        filter:blur(30px);

        pointer-events:none;
    }

    .auth-wrapper {

        display:flex;
        justify-content:center;
        align-items:flex-start;

        padding-top:90px;
        padding-inline:20px;

        min-height:100vh;

        position:relative;
        z-index:2;
    }

    .auth-container {

        width:100%;
        max-width:460px;

        position:relative;
        overflow:hidden;

        padding:42px 36px;

        border-radius:34px;

        background:
            linear-gradient(
                145deg,
                rgba(255,255,255,0.08),
                rgba(255,255,255,0.03)
            );

        backdrop-filter:blur(28px);

        border:1px solid rgba(255,255,255,0.08);

        box-shadow:
            0 30px 70px rgba(0,0,0,0.45),
            0 0 45px rgba(124,92,255,0.10);

        color:white;

        transition:.35s ease;

        animation:fadeUp .6s ease;
    }

    .auth-container::before{
        content:"";
        position:absolute;
        inset:0;

        background:
            linear-gradient(
                135deg,
                rgba(124,92,255,0.10),
                transparent 35%,
                rgba(177,77,255,0.08)
            );

        pointer-events:none;
    }

    .auth-container:hover{

        transform:translateY(-8px);

        box-shadow:
            0 40px 90px rgba(0,0,0,0.55),
            0 0 60px rgba(124,92,255,0.16);
    }

    @@keyframes fadeUp{

        from{
            opacity:0;
            transform:translateY(25px);
        }

        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .mini-glow{
        position:absolute;

        width:180px;
        height:180px;

        border-radius:50%;

        background:
            radial-gradient(circle,
                rgba(124,92,255,0.16),
                transparent 70%);

        filter:blur(25px);

        pointer-events:none;
    }

    .glow-1{
        top:-60px;
        left:-60px;
    }

    .glow-2{
        bottom:-80px;
        right:-60px;
    }

    .auth-header{
        text-align:center;
        margin-bottom:30px;
        position:relative;
        z-index:2;
    }

    .lock-icon{

        width:90px;
        height:90px;

        margin:0 auto 18px;

        border-radius:28px;

        display:flex;
        align-items:center;
        justify-content:center;

        font-size:38px;

        background:
            linear-gradient(
                135deg,
                rgba(124,92,255,0.25),
                rgba(177,77,255,0.15)
            );

        border:1px solid rgba(124,92,255,0.25);

        box-shadow:
            0 0 35px rgba(124,92,255,0.20);

        animation:floaty 3s ease-in-out infinite;
    }

    @@keyframes floaty{

        0%{
            transform:translateY(0px);
        }

        50%{
            transform:translateY(-6px);
        }

        100%{
            transform:translateY(0px);
        }
    }

    .auth-title {

        font-size:32px;

        font-weight:800;

        letter-spacing:-1px;

        margin-bottom:8px;

        background:
            linear-gradient(90deg,#ffffff,#d9ccff);

        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .auth-subtitle{

        color:var(--muted);

        font-size:14px;

        line-height:1.7;
    }

    .form-group{
        margin-bottom:22px;
        position:relative;
        z-index:2;
    }

    label {

        display:block;

        margin-bottom:10px;

        font-size:13px;

        font-weight:600;

        color:#d5d5ea;

        letter-spacing:.3px;
    }

    .input-wrapper{
        position:relative;
    }

    .input-icon{

        position:absolute;

        left:18px;
        top:50%;

        transform:translateY(-50%);

        color:#9ca3af;

        font-size:14px;

        pointer-events:none;
    }

    .form-control {

        width:100%;

        border-radius:20px;

        background:
            rgba(255,255,255,0.05);

        border:1px solid rgba(255,255,255,0.06);

        color:white;

        padding:16px 18px 16px 48px;

        font-size:14px;

        transition:.25s ease;

        backdrop-filter:blur(10px);

        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.03);
    }

    .form-control::placeholder{
        color:#8e8ead;
    }

    .form-control:focus {

        outline:none;

        background:
            rgba(255,255,255,0.07);

        border-color:
            rgba(124,92,255,0.45);

        box-shadow:
            0 0 0 4px rgba(124,92,255,0.12),
            0 0 25px rgba(124,92,255,0.15);

        color:white;
    }

    .btn-auth {

        width:100%;

        border:none;

        border-radius:999px;

        padding:16px 20px;

        background:
            linear-gradient(
                135deg,
                var(--purple),
                var(--purple2)
            );

        color:white;

        font-size:14px;
        font-weight:700;

        transition:.3s ease;

        box-shadow:
            0 16px 35px rgba(124,92,255,0.35);

        position:relative;
        overflow:hidden;

        margin-top:8px;
    }

    .btn-auth::before{
        content:"";
        position:absolute;
        inset:0;

        background:
            linear-gradient(
                120deg,
                transparent,
                rgba(255,255,255,0.18),
                transparent
            );

        transform:translateX(-100%);
        transition:.6s;
    }

    .btn-auth:hover::before{
        transform:translateX(100%);
    }

    .btn-auth:hover {

        transform:translateY(-4px) scale(1.02);

        box-shadow:
            0 24px 50px rgba(124,92,255,0.45);
    }

    .message {

        position:relative;
        z-index:2;

        display:flex;
        align-items:center;
        gap:12px;

        padding:15px 18px;

        border-radius:20px;

        margin-bottom:20px;

        font-size:13px;

        font-weight:600;

        backdrop-filter:blur(16px);

        border:1px solid transparent;

        animation:fadeAlert .4s ease;
    }

    @@keyframes fadeAlert{

        from{
            opacity:0;
            transform:translateY(-10px);
        }

        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .error {

        background:
            linear-gradient(
                135deg,
                rgba(239,68,68,0.18),
                rgba(239,68,68,0.08)
            );

        color:#fca5a5;

        border-color:
            rgba(239,68,68,0.18);
    }

    .success {

        background:
            linear-gradient(
                135deg,
                rgba(34,197,94,0.18),
                rgba(34,197,94,0.08)
            );

        color:#86efac;

        border-color:
            rgba(34,197,94,0.18);
    }

    @@media(max-width:576px){

        .auth-wrapper{
            padding-top:60px;
        }

        .auth-container{
            padding:34px 24px;
            border-radius:28px;
        }

        .auth-title{
            font-size:26px;
        }

        .lock-icon{
            width:78px;
            height:78px;
            font-size:32px;
        }

    }

</style>

<div class="auth-wrapper">

    <div class="auth-container">

        <div class="mini-glow glow-1"></div>
        <div class="mini-glow glow-2"></div>

        <div class="auth-header">

            <div class="lock-icon">
                🔒
            </div>

            <h2 class="auth-title">
                Şifre Değiştir
            </h2>

            <div class="auth-subtitle">
                Hesabının güvenliği için yeni bir şifre belirle.
            </div>

        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="message error">
                ❌ @ViewBag.ErrorMessage
            </div>
        }

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="message success">
                ✅ @ViewBag.SuccessMessage
            </div>
        }

        <form method="post">

            <div class="form-group">

                <label>Eski Şifre</label>

                <div class="input-wrapper">

                    <span class="input-icon">
                        <i class="fa-solid fa-lock"></i>
                    </span>

                    <input type="password"
                           name="EskiSifre"
                           class="form-control"
                           placeholder="••••••••"
                           required />

                </div>

            </div>

            <div class="form-group">

                <label>Yeni Şifre</label>

                <div class="input-wrapper">

                    <span class="input-icon">
                        <i class="fa-solid fa-key"></i>
                    </span>

                    <input type="password"
                           name="YeniSifre"
                           class="form-control"
                           placeholder="••••••••"
                           required />

                </div>

            </div>

            <div class="form-group">

                <label>Güvenlik Kodu (@ViewBag.SecurityQuestion)</label>

                <div class="input-wrapper">

                    <span class="input-icon">=</span>

                    <input type="text"
                           name="GuvenlikKodu"
                           class="form-control"
                           placeholder="Sonucu yaz"
                           inputmode="numeric"
                           required />

                </div>

            </div>

            <button type="submit" class="btn-auth">
                🔄 Şifreyi Güncelle
            </button>

        </form>

    </div>

</div>
