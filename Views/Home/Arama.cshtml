@model Tuple<List<Loopin.Models.Video>, List<Loopin.Models.Kullanici>>

@{
    ViewData["Title"] = "Arama Sonuçları";
}

<style>

    :root{
        --bg:#050816;
        --card:rgba(15,23,42,.78);
        --border:rgba(255,255,255,.08);
        --text:#f8fafc;
        --muted:#94a3b8;
        --primary:#8b5cf6;
        --primary2:#6366f1;
        --accent:#60a5fa;
        --success:#22c55e;
        --danger:#ef4444;
    }

    body{
        background:
            radial-gradient(circle at top left, rgba(99,102,241,.18), transparent 30%),
            radial-gradient(circle at top right, rgba(168,85,247,.14), transparent 25%),
            linear-gradient(180deg,#050816,#0b1020 60%,#050816);
        color:var(--text);
    }

    .search-page{
        animation:fadeIn .45s ease;
    }

    @@keyframes fadeIn{
        from{
            opacity:0;
            transform:translateY(10px);
        }
        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    /* HEADER */

    .search-header{
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:20px;
        flex-wrap:wrap;
        margin-bottom:34px;
    }

    .search-title{
        font-size:clamp(2rem,4vw,3rem);
        font-weight:900;
        line-height:1;
        margin-bottom:10px;
        letter-spacing:-.04em;
        background:linear-gradient(90deg,#c084fc,#60a5fa,#818cf8);
        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .search-subtitle{
        color:var(--muted);
        font-size:14px;
        max-width:650px;
        line-height:1.7;
    }

    .result-stats{
        display:flex;
        gap:14px;
        flex-wrap:wrap;
    }

    .stat-box{
        min-width:120px;
        padding:14px 18px;
        border-radius:20px;
        background:rgba(255,255,255,.05);
        border:1px solid rgba(255,255,255,.08);
        backdrop-filter:blur(20px);
        box-shadow:0 15px 35px rgba(0,0,0,.35);
        text-align:center;
    }

    .stat-box strong{
        display:block;
        font-size:24px;
        font-weight:900;
    }

    .stat-box span{
        font-size:12px;
        color:var(--muted);
    }

    /* TABS */

    .custom-tabs{
        display:flex;
        gap:14px;
        margin-bottom:30px;
        flex-wrap:wrap;
    }

    .tab-btn{
        border:none;
        padding:12px 22px;
        border-radius:999px;
        background:rgba(255,255,255,.05);
        color:#dbe4ff;
        font-weight:700;
        transition:.25s ease;
        border:1px solid rgba(255,255,255,.06);
        backdrop-filter:blur(10px);
    }

    .tab-btn:hover{
        transform:translateY(-2px);
        background:rgba(255,255,255,.08);
    }

    .tab-btn.active{
        color:white;
        border:none;
        background:linear-gradient(135deg,var(--primary),var(--accent));
        box-shadow:0 15px 35px rgba(99,102,241,.35);
    }

    .tab-content{
        display:none;
    }

    .tab-content.active{
        display:block;
        animation:fadeIn .35s ease;
    }

    /* VIDEO CARD */

    .video-card{
        position:relative;
        overflow:hidden;
        border-radius:28px;
        background:linear-gradient(145deg,rgba(15,23,42,.96),rgba(17,24,39,.82));
        border:1px solid rgba(255,255,255,.07);
        backdrop-filter:blur(18px);
        transition:.35s ease;
        box-shadow:0 20px 45px rgba(0,0,0,.32);
        height:100%;
    }

    .video-card:hover{
        transform:translateY(-10px);
        border-color:rgba(139,92,246,.4);
        box-shadow:
            0 35px 70px rgba(0,0,0,.45),
            0 0 40px rgba(139,92,246,.15);
    }

    .video-preview{
        position:relative;
        overflow:hidden;
        height:220px;
    }

    .video-img{
        width:100%;
        height:100%;
        object-fit:cover;
        transition:transform .6s ease;
    }

    .video-card:hover .video-img{
        transform:scale(1.08);
    }

    .video-overlay{
        position:absolute;
        inset:0;
        background:
            linear-gradient(to top, rgba(0,0,0,.85), transparent 50%),
            rgba(0,0,0,.18);
        opacity:0;
        display:flex;
        align-items:center;
        justify-content:center;
        transition:.3s ease;
    }

    .video-card:hover .video-overlay{
        opacity:1;
    }

    .play-btn{
        width:78px;
        height:78px;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:28px;
        color:white;
        backdrop-filter:blur(15px);
        background:rgba(255,255,255,.14);
        border:1px solid rgba(255,255,255,.2);
        box-shadow:0 0 40px rgba(255,255,255,.18);
        transform:scale(.8);
        transition:.25s ease;
    }

    .video-card:hover .play-btn{
        transform:scale(1);
    }

    .video-content{
        padding:20px;
    }

    .video-title{
        font-size:17px;
        font-weight:800;
        line-height:1.5;
        margin-bottom:10px;
        color:white;

        display:-webkit-box;
        -webkit-line-clamp:2;
        -webkit-box-orient:vertical;
        overflow:hidden;
    }

    .video-desc{
        color:var(--muted);
        font-size:13px;
        line-height:1.7;
        margin-bottom:16px;
        min-height:44px;

        display:-webkit-box;
        -webkit-line-clamp:2;
        -webkit-box-orient:vertical;
        overflow:hidden;
    }

    .video-meta{
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin-bottom:18px;
    }

    .meta-chip{
        padding:8px 12px;
        border-radius:999px;
        font-size:11px;
        font-weight:700;
        background:rgba(255,255,255,.05);
        border:1px solid rgba(255,255,255,.06);
        color:#dbe4ff;
    }

    .creator-link{
        color:#c4b5fd;
        text-decoration:none;
        transition:.2s ease;
    }

    .creator-link:hover{
        color:white;
    }

    .video-actions{
        display:flex;
        gap:10px;
        flex-wrap:wrap;
    }

    .btn-modern{
        flex:1;
        min-width:120px;
        border:none;
        border-radius:16px;
        padding:11px 16px;
        font-size:13px;
        font-weight:700;
        transition:.25s ease;
    }

    .btn-watch{
        text-decoration:none;
        color:white;
        display:flex;
        align-items:center;
        justify-content:center;
        gap:8px;

        background:linear-gradient(135deg,var(--primary),var(--primary2));
        box-shadow:0 12px 25px rgba(99,102,241,.3);
    }

    .btn-watch:hover{
        color:white;
        transform:translateY(-2px);
        box-shadow:0 18px 35px rgba(99,102,241,.45);
    }

    .btn-save{
        color:#fde68a;
        background:rgba(245,158,11,.12);
        border:1px solid rgba(245,158,11,.25);
    }

    .btn-save:hover{
        color:white;
        background:rgba(245,158,11,.18);
        transform:translateY(-2px);
    }

    /* USER CARD */

    .user-grid{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
        gap:18px;
    }

    .user-card{
        position:relative;
        overflow:hidden;
        padding:22px;
        border-radius:26px;
        background:linear-gradient(145deg,rgba(15,23,42,.95),rgba(17,24,39,.82));
        border:1px solid rgba(255,255,255,.07);
        backdrop-filter:blur(18px);
        transition:.3s ease;
        box-shadow:0 20px 45px rgba(0,0,0,.3);
    }

    .user-card:hover{
        transform:translateY(-8px);
        border-color:rgba(96,165,250,.35);
        box-shadow:
            0 35px 70px rgba(0,0,0,.45),
            0 0 40px rgba(96,165,250,.12);
    }

    .user-top{
        display:flex;
        align-items:center;
        gap:16px;
        margin-bottom:18px;
    }

    .user-avatar{
        width:64px;
        height:64px;
        border-radius:22px;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:24px;
        font-weight:900;
        background:linear-gradient(135deg,#8b5cf6,#3b82f6);
        box-shadow:0 15px 30px rgba(99,102,241,.35);
    }

    .user-name{
        font-size:18px;
        font-weight:800;
        color:white;
        text-decoration:none;
    }

    .user-name:hover{
        color:#c4b5fd;
    }

    .user-email{
        font-size:13px;
        color:var(--muted);
        margin-top:4px;
        word-break:break-word;
    }

    .user-actions{
        margin-top:14px;
    }

    .btn-subscribe{
        width:100%;
        border:none;
        border-radius:16px;
        padding:12px;
        font-weight:800;
        transition:.25s ease;
    }

    .btn-follow{
        background:linear-gradient(135deg,#22c55e,#16a34a);
        color:white;
        box-shadow:0 12px 30px rgba(34,197,94,.25);
    }

    .btn-follow:hover{
        transform:translateY(-2px);
        box-shadow:0 18px 35px rgba(34,197,94,.35);
    }

    .btn-unfollow{
        color:#fecaca;
        background:rgba(239,68,68,.12);
        border:1px solid rgba(239,68,68,.25);
    }

    .btn-unfollow:hover{
        color:white;
        background:rgba(239,68,68,.18);
        transform:translateY(-2px);
    }

    /* EMPTY */

    .empty-box{
        text-align:center;
        padding:90px 30px;
        border-radius:34px;
        background:linear-gradient(145deg,rgba(15,23,42,.92),rgba(17,24,39,.85));
        border:1px solid rgba(255,255,255,.08);
        backdrop-filter:blur(24px);
        box-shadow:0 35px 90px rgba(0,0,0,.45);
    }

    .empty-icon{
        width:90px;
        height:90px;
        margin:0 auto 24px;
        display:flex;
        align-items:center;
        justify-content:center;
        border-radius:28px;
        font-size:40px;
        background:rgba(139,92,246,.15);
        border:1px solid rgba(139,92,246,.35);
        box-shadow:0 0 35px rgba(139,92,246,.25);
    }

    .empty-box h3{
        font-size:34px;
        font-weight:900;
        margin-bottom:12px;
        background:linear-gradient(90deg,#818cf8,#c084fc);
        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .empty-box p{
        color:var(--muted);
        margin-bottom:0;
    }

    /* RESPONSIVE */

    @@media(max-width:768px){

        .search-header{
            align-items:flex-start;
        }

        .video-preview{
            height:200px;
        }

        .video-actions{
            flex-direction:column;
        }

        .btn-modern{
            width:100%;
        }

        .user-grid{
            grid-template-columns:1fr;
        }
    }

</style>

<div class="container py-4 search-page">

    <!-- HEADER -->

    <div class="search-header">

        <div>

            <div class="search-title">
                🔍 Arama Sonuçları
            </div>

            <div class="search-subtitle">
                Aradığın videoları ve kullanıcıları keşfet.
                Trend içeriklere ulaşabilir ve yeni içerik üreticilerini takip edebilirsin.
            </div>

        </div>

        <div class="result-stats">

            <div class="stat-box">
                <strong>@Model.Item1.Count</strong>
                <span>Video</span>
            </div>

            <div class="stat-box">
                <strong>@Model.Item2.Count</strong>
                <span>Kullanıcı</span>
            </div>

        </div>

    </div>

    <!-- TABS -->

    <div class="custom-tabs">

        <button class="tab-btn active" onclick="openTab(event,'videos')">
            🎬 Videolar
        </button>

        <button class="tab-btn" onclick="openTab(event,'users')">
            👤 Kullanıcılar
        </button>

    </div>

    <!-- VIDEOS -->

    <div id="videos" class="tab-content active">

        @if (!Model.Item1.Any())
        {
            <div class="empty-box">

                <div class="empty-icon">
                    🎬
                </div>

                <h3>Video bulunamadı</h3>

                <p>
                    Farklı anahtar kelimeler ile tekrar arama yapmayı deneyebilirsin.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var video in Model.Item1.Take(60))
                {
                    <div class="col-xxl-3 col-xl-4 col-md-6">

                        <div class="video-card">

                            <!-- VIDEO -->

                            <div class="video-preview">

                                <video class="video-img" muted preload="metadata">
                                    <source src="@video.VideoUrl" type="video/mp4" />
                                </video>

                                <div class="video-overlay">

                                    <div class="play-btn">
                                        ▶
                                    </div>

                                </div>

                            </div>

                            <!-- CONTENT -->

                            <div class="video-content">

                                <div class="video-title">
                                    @video.Baslik
                                </div>

                                <div class="video-desc">
                                    @video.Aciklama
                                </div>

                                <div class="video-meta">

                                    <div class="meta-chip">
                                        👁 @video.IzlenmeSayisi İzlenme
                                    </div>

                                    <div class="meta-chip">
                                        👍 @video.LikeSayisi Beğeni
                                    </div>

                                    <div class="meta-chip">
                                        📅 @video.YuklenmeTarihi.ToString("dd MMM yyyy")
                                    </div>

                                </div>

                                <div class="mb-3">

                                    <a asp-controller="Home"
                                       asp-action="Kullanici"
                                       asp-route-id="@video.KullaniciId"
                                       class="creator-link">

                                        👤 @video.Kullanici?.KullaniciAdi

                                    </a>

                                </div>

                                <!-- ACTIONS -->

                                <div class="video-actions">

                                    <a asp-controller="Home"
                                       asp-action="Izle"
                                       asp-route-id="@video.Id"
                                       class="btn-modern btn-watch">

                                        ▶ İzle

                                    </a>

                                    <form asp-controller="Home"
                                          asp-action="DahaSonraEkle"
                                          asp-route-id="@video.Id"
                                          method="post"
                                          class="flex-grow-1">

                                        <button class="btn-modern btn-save w-100">
                                            ⏳ Listeye Ekle
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

    <!-- USERS -->

    <div id="users" class="tab-content">

        @if (!Model.Item2.Any())
        {
            <div class="empty-box">

                <div class="empty-icon">
                    👤
                </div>

                <h3>Kullanıcı bulunamadı</h3>

                <p>
                    Arama kriterlerine uygun bir kullanıcı bulunamadı.
                </p>

            </div>
        }
        else
        {
            <div class="user-grid">

                @foreach (var user in Model.Item2.Take(60))
                {
                    <div class="user-card">

                        <div class="user-top">

                            <div class="user-avatar">
                                @(string.IsNullOrWhiteSpace(user.KullaniciAdi)
                                    ? "?"
                                    : user.KullaniciAdi.Substring(0,1).ToUpper())
                            </div>

                            <div>

                                <a asp-controller="Home"
                                   asp-action="Kullanici"
                                   asp-route-id="@user.Id"
                                   class="user-name">

                                    @user.KullaniciAdi

                                </a>

                                <div class="user-email">
                                    📧 @user.Email
                                </div>

                            </div>

                        </div>

                        <div class="user-actions">

                            @if (Context.Session.GetString("UserEmail") != null &&
                                 Context.Session.GetString("UserEmail") != user.Email)
                            {
                                <form asp-controller="Home"
                                      asp-action="AbonelikToggle"
                                      asp-route-id="@user.Id"
                                      method="post">

                                    @if (ViewBag.Abonelikler != null &&
                                         ((List<int>)ViewBag.Abonelikler).Contains(user.Id))
                                    {
                                        <button class="btn-subscribe btn-unfollow">
                                            ❌ Abonelikten Çık
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-subscribe btn-follow">
                                            ➕ Abone Ol
                                        </button>
                                    }

                                </form>
                            }
                            else
                            {
                                <a asp-controller="Home"
                                   asp-action="Kullanici"
                                   asp-route-id="@user.Id"
                                   class="btn-subscribe btn-follow text-decoration-none d-flex align-items-center justify-content-center">

                                    👤 Profili Gör

                                </a>
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

<script>

    function openTab(event, tabId) {

        document.querySelectorAll('.tab-content').forEach(el => {
            el.classList.remove('active');
        });

        document.querySelectorAll('.tab-btn').forEach(el => {
            el.classList.remove('active');
        });

        document.getElementById(tabId).classList.add('active');
        event.currentTarget.classList.add('active');
    }

</script>
