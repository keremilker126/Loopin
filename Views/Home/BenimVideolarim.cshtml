@model List<Loopin.Models.Video>

@{
    ViewData["Title"] = "Benim Videolarım";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<style>

    :root {
        --purple: #7c5cff;
        --purple2: #b14dff;
        --danger: #ef4444;
        --bg: #080811;
        --card: rgba(255,255,255,0.05);
        --border: rgba(255,255,255,0.08);
        --text: #ffffff;
        --muted: #9fa4b7;
    }

    /* PAGE */

    .myvideos-page {
        position: relative;
        overflow: hidden;
        animation: fadeIn 0.4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .myvideos-page::before {
        content: "";
        position: fixed;
        width: 700px;
        height: 700px;
        background: radial-gradient(rgba(124,92,255,0.12), transparent 70%);
        top: -250px;
        right: -200px;
        pointer-events: none;
    }

    .myvideos-page::after {
        content: "";
        position: fixed;
        width: 650px;
        height: 650px;
        background: radial-gradient(rgba(177,77,255,0.10), transparent 70%);
        bottom: -250px;
        left: -200px;
        pointer-events: none;
    }

    /* HERO */

    .videos-hero {
        position: relative;
        overflow: hidden;

        border-radius: 38px;

        padding: 42px;

        margin-bottom: 38px;

        background:
            radial-gradient(circle at top left,
            rgba(124,92,255,0.20),
            transparent 35%),

            radial-gradient(circle at bottom right,
            rgba(177,77,255,0.18),
            transparent 35%),

            rgba(255,255,255,0.05);

        border: 1px solid rgba(255,255,255,0.08);

        backdrop-filter: blur(24px);

        box-shadow:
            0 25px 60px rgba(0,0,0,0.35),
            inset 0 1px 0 rgba(255,255,255,0.03);
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;

        padding: 10px 18px;

        border-radius: 999px;

        background: rgba(255,255,255,0.06);

        border: 1px solid rgba(255,255,255,0.08);

        color: #ddd6ff;

        font-size: 13px;
        font-weight: 700;

        margin-bottom: 18px;
    }

    .hero-title {
        font-size: 52px;
        font-weight: 900;
        line-height: 1.05;
        margin-bottom: 14px;
        letter-spacing: -1px;
    }

    .hero-title span {
        background: linear-gradient(135deg,
            #ffffff,
            #c4b5fd,
            #b14dff);

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        max-width: 700px;

        color: var(--muted);

        line-height: 1.8;

        font-size: 15px;
    }

    /* HEADER */

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 20px;

        margin-bottom: 28px;

        flex-wrap: wrap;
    }

    .section-title {
        font-size: 30px;
        font-weight: 800;

        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-title i {
        color: #b14dff;
    }

    .section-subtitle {
        margin-top: 5px;
        color: var(--muted);
        font-size: 14px;
    }

    .upload-btn-top {
        border: none;

        border-radius: 20px;

        padding: 14px 22px;

        text-decoration: none;

        font-size: 14px;
        font-weight: 700;

        display: flex;
        align-items: center;
        gap: 10px;

        background: linear-gradient(135deg,
            var(--purple),
            var(--purple2));

        color: white;

        transition: 0.25s ease;

        box-shadow:
            0 15px 35px rgba(124,92,255,0.3);
    }

    .upload-btn-top:hover {
        transform: translateY(-2px);
        color: white;

        box-shadow:
            0 20px 40px rgba(124,92,255,0.45);
    }

    /* GRID */

    .videos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px,1fr));
        gap: 28px;
    }

    /* CARD */

    .video-card-modern {
        position: relative;
        overflow: hidden;

        border-radius: 32px;

        background: rgba(255,255,255,0.05);

        border: 1px solid rgba(255,255,255,0.08);

        backdrop-filter: blur(24px);

        transition: 0.35s ease;

        box-shadow:
            0 18px 40px rgba(0,0,0,0.28);
    }

    .video-card-modern:hover {
        transform: translateY(-10px);

        border-color: rgba(124,92,255,0.35);

        box-shadow:
            0 35px 70px rgba(0,0,0,0.5),
            0 0 40px rgba(124,92,255,0.14);
    }

    /* VIDEO */

    .video-preview-wrapper {
        position: relative;
        overflow: hidden;
        height: 220px;
    }

    .video-preview {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.5s ease;
        background: black;
    }

    .video-card-modern:hover .video-preview {
        transform: scale(1.08);
    }

    /* OVERLAY */

    .video-overlay {
        position: absolute;
        inset: 0;

        background:
            linear-gradient(to top,
            rgba(0,0,0,0.78),
            rgba(0,0,0,0.08));

        display: flex;
        justify-content: center;
        align-items: center;

        opacity: 0;
        transition: 0.3s ease;
    }

    .video-card-modern:hover .video-overlay {
        opacity: 1;
    }

    .play-btn {
        width: 82px;
        height: 82px;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        background: rgba(255,255,255,0.14);

        border: 1px solid rgba(255,255,255,0.18);

        backdrop-filter: blur(14px);

        color: white;

        font-size: 28px;

        transition: 0.3s ease;
    }

    .video-card-modern:hover .play-btn {
        transform: scale(1.08);
    }

    /* TOP BADGES */

    .card-top {
        position: absolute;

        top: 14px;
        left: 14px;
        right: 14px;

        display: flex;
        justify-content: space-between;

        z-index: 5;
    }

    .card-badge {
        padding: 8px 14px;

        border-radius: 999px;

        font-size: 11px;
        font-weight: 800;

        backdrop-filter: blur(10px);

        border: 1px solid rgba(255,255,255,0.08);
    }

    .badge-mine {
        background: linear-gradient(135deg,
            var(--purple),
            var(--purple2));

        color: white;

        box-shadow:
            0 12px 25px rgba(124,92,255,0.28);
    }

    .badge-stats {
        background: rgba(0,0,0,0.4);
        color: white;
    }

    /* CONTENT */

    .video-content {
        padding: 24px;
    }

    .video-title {
        font-size: 20px;
        font-weight: 800;
        line-height: 1.4;
        margin-bottom: 10px;
    }

    .video-desc {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
        height: 48px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    /* META */

    .video-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 14px;

        margin-bottom: 24px;

        flex-wrap: wrap;
    }

    .meta-date {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .meta-icon {
        width: 44px;
        height: 44px;

        border-radius: 15px;

        background: linear-gradient(135deg,
            var(--purple),
            var(--purple2));

        display: flex;
        align-items: center;
        justify-content: center;

        color: white;

        box-shadow:
            0 12px 28px rgba(124,92,255,0.28);
    }

    .meta-title {
        font-size: 13px;
        color: #d9d9ef;
        font-weight: 700;
    }

    .meta-sub {
        font-size: 12px;
        color: #8f94aa;
    }

    .stats {
        display: flex;
        align-items: center;
        gap: 12px;

        font-size: 13px;
        color: #d7dae7;
    }

    /* BUTTONS */

    .action-buttons {
        display: flex;
        gap: 12px;
    }

    .btn-modern {
        flex: 1;

        border: none;

        border-radius: 20px;

        padding: 15px;

        font-size: 14px;
        font-weight: 700;

        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;

        transition: 0.25s ease;

        text-decoration: none;
    }

    .btn-watch {
        background: linear-gradient(135deg,
            var(--purple),
            var(--purple2));

        color: white;

        box-shadow:
            0 15px 35px rgba(124,92,255,0.3);
    }

    .btn-watch:hover {
        transform: translateY(-2px);

        color: white;

        box-shadow:
            0 20px 40px rgba(124,92,255,0.45);
    }

    .btn-delete {
        background: rgba(239,68,68,0.12);

        border: 1px solid rgba(239,68,68,0.18);

        color: #fca5a5;
    }

    .btn-delete:hover {
        background: rgba(239,68,68,0.20);
        transform: translateY(-2px);
    }

    /* EMPTY */

    .empty-wrapper {
        min-height: 70vh;

        display: flex;
        justify-content: center;
        align-items: center;
    }

    .empty-box {
        width: 100%;
        max-width: 760px;

        text-align: center;

        padding: 60px;

        border-radius: 38px;

        background: rgba(255,255,255,0.05);

        border: 1px solid rgba(255,255,255,0.08);

        backdrop-filter: blur(24px);

        box-shadow:
            0 25px 60px rgba(0,0,0,0.35);
    }

    .empty-icon {
        width: 120px;
        height: 120px;

        border-radius: 30px;

        margin: auto;
        margin-bottom: 28px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: linear-gradient(135deg,
            var(--purple),
            var(--purple2));

        color: white;

        font-size: 46px;

        box-shadow:
            0 25px 50px rgba(124,92,255,0.35);
    }

    .empty-title {
        font-size: 38px;
        font-weight: 900;
        margin-bottom: 12px;

        background: linear-gradient(135deg,
            #ffffff,
            #c4b5fd,
            #b14dff);

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .empty-text {
        color: var(--muted);
        line-height: 1.8;
        margin-bottom: 28px;
    }

    /* MODAL */

    .modal-overlay {
        position: fixed;
        inset: 0;

        background: rgba(0,0,0,0.75);

        backdrop-filter: blur(10px);

        display: none;

        justify-content: center;
        align-items: center;

        z-index: 99999;

        animation: fadeModal 0.2s ease;
    }

    @@keyframes fadeModal {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-box {
        width: 100%;
        max-width: 420px;

        padding: 34px;

        border-radius: 32px;

        background: rgba(20,20,35,0.95);

        border: 1px solid rgba(255,255,255,0.08);

        backdrop-filter: blur(24px);

        box-shadow:
            0 25px 60px rgba(0,0,0,0.45);

        text-align: center;

        animation: popIn 0.25s ease;
    }

    @@keyframes popIn {
        from {
            transform: scale(0.85);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-icon {
        width: 90px;
        height: 90px;

        border-radius: 26px;

        margin: auto;
        margin-bottom: 22px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: rgba(239,68,68,0.12);

        color: #f87171;

        font-size: 36px;

        border: 1px solid rgba(239,68,68,0.18);
    }

    .modal-title {
        font-size: 30px;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .modal-text {
        color: var(--muted);
        line-height: 1.8;
        margin-bottom: 28px;
    }

    .modal-actions {
        display: flex;
        gap: 14px;
    }

    .modal-btn {
        flex: 1;

        border: none;

        border-radius: 18px;

        padding: 15px;

        font-size: 14px;
        font-weight: 700;

        transition: 0.25s ease;
    }

    .btn-cancel {
        background: rgba(255,255,255,0.06);
        color: white;
    }

    .btn-cancel:hover {
        background: rgba(255,255,255,0.10);
    }

    .btn-confirm {
        background: linear-gradient(135deg,
            #ef4444,
            #dc2626);

        color: white;

        box-shadow:
            0 15px 35px rgba(239,68,68,0.28);
    }

    .btn-confirm:hover {
        transform: translateY(-2px);
    }

    /* MOBILE */

    @@media(max-width:768px) {

        .videos-hero {
            padding: 28px;
            border-radius: 28px;
        }

        .hero-title {
            font-size: 38px;
        }

        .videos-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
        }

        .empty-box {
            padding: 40px 24px;
        }

        .modal-box {
            margin: 20px;
            padding: 26px;
        }

        .modal-actions {
            flex-direction: column;
        }
    }

</style>

<div class="myvideos-page">

    <!-- HERO -->
    <div class="videos-hero">

        <div class="hero-badge">
            <i class="fa-solid fa-photo-film"></i>
            İçerik Stüdyon
        </div>

        <div class="hero-title">
            Benim <span>Videolarım</span>
        </div>

        <div class="hero-subtitle">
            Yüklediğin videoları yönet, görüntüle ve içeriklerini düzenle.
        </div>

    </div>

    <!-- EMPTY -->
    @if (!Model.Any())
    {
        <div class="empty-wrapper">

            <div class="empty-box">

                <div class="empty-icon">
                    <i class="fa-solid fa-video"></i>
                </div>

                <div class="empty-title">
                    Henüz Video Yok
                </div>

                <div class="empty-text">
                    İlk videonu yükleyerek içerik üretmeye başlayabilirsin 🚀
                </div>

                <a asp-controller="Home"
                   asp-action="Yukle"
                   class="upload-btn-top">

                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    Video Yükle

                </a>

            </div>

        </div>
    }
    else
    {

        <!-- HEADER -->
        <div class="section-header">

            <div>

                <div class="section-title">
                    <i class="fa-solid fa-layer-group"></i>
                    Video Arşivin
                </div>

                <div class="section-subtitle">
                    Toplam @Model.Count video içeriyor
                </div>

            </div>

            <a asp-controller="Home"
               asp-action="Yukle"
               class="upload-btn-top">

                <i class="fa-solid fa-plus"></i>
                Yeni Video

            </a>

        </div>

        <!-- GRID -->
        <div class="videos-grid">

            @foreach (var video in Model)
            {
                <div class="video-card-modern">

                    <!-- VIDEO -->
                    <div class="video-preview-wrapper">

                        <!-- BADGES -->
                        <div class="card-top">

                            <div class="card-badge badge-mine">
                                🎬 SENİN
                            </div>

                            <div class="card-badge badge-stats">
                                👁 @video.IzlenmeSayisi
                            </div>

                        </div>

                        <!-- VIDEO -->
                        <video class="video-preview"
                               muted
                               preload="metadata">

                            <source src="@video.VideoUrl"
                                    type="video/mp4" />

                        </video>

                        <!-- OVERLAY -->
                        <div class="video-overlay">

                            <div class="play-btn">
                                <i class="fa-solid fa-play"></i>
                            </div>

                        </div>

                    </div>

                    <!-- CONTENT -->
                    <div class="video-content">

                        <div class="video-title">
                            @video.Baslik
                        </div>

                        <div class="video-desc">
                            @video.Aciklama
                        </div>

                        <!-- META -->
                        <div class="video-meta">

                            <div class="meta-date">

                                <div class="meta-icon">
                                    <i class="fa-solid fa-calendar"></i>
                                </div>

                                <div>

                                    <div class="meta-title">
                                        Yüklenme Tarihi
                                    </div>

                                    <div class="meta-sub">
                                        @video.YuklenmeTarihi.ToString("dd MMM yyyy")
                                    </div>

                                </div>

                            </div>

                            <div class="stats">
                                <span>👍 @video.LikeSayisi</span>
                            </div>

                        </div>

                        <!-- BUTTONS -->
                        <div class="action-buttons">

                            <!-- WATCH -->
                            <a href="/Home/Izle/@video.Id"
                               class="btn-modern btn-watch">

                                <i class="fa-solid fa-play"></i>
                                İzle

                            </a>

                            <!-- DELETE -->
                            <form asp-controller="Home"
                                  asp-action="VideoSil"
                                  asp-route-id="@video.Id"
                                  method="post"
                                  style="flex:1;"
                                  onsubmit="return openDeleteModal(this);">

                                <button type="submit"
                                        class="btn-modern btn-delete w-100">

                                    <i class="fa-solid fa-trash"></i>
                                    Sil

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

<!-- DELETE MODAL -->
<div id="deleteModal"
     class="modal-overlay">

    <div class="modal-box">

        <div class="modal-icon">
            <i class="fa-solid fa-trash"></i>
        </div>

        <div class="modal-title">
            Videoyu Sil?
        </div>

        <div class="modal-text">
            Bu işlem geri alınamaz. Video kalıcı olarak silinecek.
        </div>

        <div class="modal-actions">

            <button id="cancelBtn"
                    class="modal-btn btn-cancel">

                Vazgeç

            </button>

            <button id="confirmBtn"
                    class="modal-btn btn-confirm">

                Evet, Sil

            </button>

        </div>

    </div>

</div>

<script>

    let currentForm = null;

    function openDeleteModal(form) {

        currentForm = form;

        document.getElementById("deleteModal").style.display = "flex";

        return false;
    }

    document.getElementById("cancelBtn").onclick = function () {

        document.getElementById("deleteModal").style.display = "none";

        currentForm = null;
    };

    document.getElementById("confirmBtn").onclick = function () {

        if (currentForm) {

            currentForm.submit();
        }
    };

    // ESC CLOSE
    document.addEventListener("keydown", function (e) {

        if (e.key === "Escape") {

            document.getElementById("deleteModal").style.display = "none";
        }
    });

</script>