@model List<Loopin.Models.Video>

@{
    ViewData["Title"] = "Daha Sonra İzle";
}

<style>
    :root {
        --bg: #070b14;
        --card: rgba(15, 23, 42, .78);
        --border: rgba(255, 255, 255, .08);
        --text: #f8fafc;
        --muted: #94a3b8;
        --primary: #8b5cf6;
        --primary2: #6366f1;
        --danger: #ef4444;
    }

    body {
        background:
            radial-gradient(circle at top left, rgba(99, 102, 241, .18), transparent 30%),
            radial-gradient(circle at top right, rgba(139, 92, 246, .14), transparent 25%),
            linear-gradient(180deg, #050816, #0b1020 60%, #050816);
        color: var(--text);
    }

    .watch-page {
        animation: fadeIn .5s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* HEADER */

    .watch-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 34px;
        flex-wrap: wrap;
    }

    .watch-title {
        font-size: clamp(2rem, 4vw, 2.9rem);
        font-weight: 900;
        line-height: 1;
        margin-bottom: 10px;
        letter-spacing: -.04em;
        background: linear-gradient(90deg, #818cf8, #a855f7, #ec4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .watch-subtitle {
        color: var(--muted);
        font-size: 14px;
        max-width: 620px;
    }

    .watch-counter {
        padding: 14px 20px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .05);
        border: 1px solid rgba(255, 255, 255, .08);
        backdrop-filter: blur(20px);
        min-width: 150px;
        text-align: center;
        box-shadow: 0 15px 35px rgba(0, 0, 0, .35);
    }

    .watch-counter strong {
        display: block;
        font-size: 26px;
        font-weight: 900;
    }

    .watch-counter span {
        color: var(--muted);
        font-size: 12px;
    }

    /* EMPTY */

    .empty-box {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: 90px 30px;
        border-radius: 34px;
        background: linear-gradient(145deg, rgba(15, 23, 42, .92), rgba(17, 24, 39, .85));
        border: 1px solid rgba(255, 255, 255, .08);
        backdrop-filter: blur(24px);
        box-shadow: 0 35px 90px rgba(0, 0, 0, .45);
    }

    .empty-box::before {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(139, 92, 246, .22), transparent 70%);
        top: -120px;
        right: -120px;
    }

    .empty-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 28px;
        font-size: 40px;
        background: rgba(139, 92, 246, .15);
        border: 1px solid rgba(139, 92, 246, .35);
        box-shadow: 0 0 35px rgba(139, 92, 246, .25);
    }

    .empty-box h3 {
        font-weight: 900;
        font-size: 34px;
        margin-bottom: 12px;
        background: linear-gradient(90deg, #818cf8, #c084fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .empty-box p {
        color: var(--muted);
        margin-bottom: 24px;
    }

    .discover-btn {
        border: none;
        color: white;
        text-decoration: none;
        font-weight: 700;
        padding: 13px 26px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--primary), var(--primary2));
        box-shadow: 0 15px 35px rgba(99, 102, 241, .35);
        transition: .25s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .discover-btn:hover {
        transform: translateY(-3px) scale(1.03);
        color: white;
        box-shadow: 0 20px 45px rgba(99, 102, 241, .45);
    }

    /* CARD */

    .video-card {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        background: linear-gradient(145deg, rgba(15, 23, 42, .96), rgba(17, 24, 39, .82));
        border: 1px solid rgba(255, 255, 255, .07);
        backdrop-filter: blur(18px);
        transition: .35s ease;
        box-shadow: 0 20px 45px rgba(0, 0, 0, .32);
        height: 100%;
    }

    .video-card:hover {
        transform: translateY(-10px);
        border-color: rgba(139, 92, 246, .4);
        box-shadow:
            0 35px 70px rgba(0, 0, 0, .45),
            0 0 40px rgba(139, 92, 246, .15);
    }

    .video-preview {
        position: relative;
        overflow: hidden;
        height: 215px;
    }

    .video-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .6s ease;
    }

    .video-card:hover .video-img {
        transform: scale(1.08);
    }

    .video-overlay {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(to top, rgba(0, 0, 0, .85), transparent 50%),
            rgba(0, 0, 0, .15);
        opacity: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .3s ease;
    }

    .video-card:hover .video-overlay {
        opacity: 1;
    }

    .play-btn {
        width: 78px;
        height: 78px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: white;
        backdrop-filter: blur(15px);
        background: rgba(255, 255, 255, .14);
        border: 1px solid rgba(255, 255, 255, .2);
        box-shadow: 0 0 40px rgba(255, 255, 255, .18);
        transform: scale(.8);
        transition: .25s ease;
    }

    .video-card:hover .play-btn {
        transform: scale(1);
    }

    /* BADGE */

    .saved-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .4px;
        color: white;
        background: rgba(15, 23, 42, .78);
        border: 1px solid rgba(255, 255, 255, .1);
        backdrop-filter: blur(14px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, .25);
    }

    .saved-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 10px #22c55e;
    }

    /* CONTENT */

    .video-content {
        padding: 18px;
    }

    .video-title {
        font-size: 17px;
        font-weight: 800;
        color: white;
        line-height: 1.4;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .video-description {
        font-size: 13px;
        line-height: 1.7;
        color: var(--muted);
        min-height: 44px;
        margin-bottom: 16px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .video-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }

    .stat-chip {
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        background: rgba(255, 255, 255, .05);
        border: 1px solid rgba(255, 255, 255, .06);
        color: #dbe4ff;
    }

    /* ACTIONS */

    .video-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-modern {
        flex: 1;
        min-width: 120px;
        border-radius: 16px;
        padding: 11px 16px;
        font-size: 13px;
        font-weight: 700;
        transition: .25s ease;
        border: none;
    }

    .btn-watch {
        color: white;
        text-decoration: none;
        background: linear-gradient(135deg, var(--primary), var(--primary2));
        box-shadow: 0 12px 25px rgba(99, 102, 241, .3);
    }

    .btn-watch:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 18px 35px rgba(99, 102, 241, .45);
    }

    .btn-remove {
        color: #fecaca;
        background: rgba(239, 68, 68, .12);
        border: 1px solid rgba(239, 68, 68, .22);
    }

    .btn-remove:hover {
        background: rgba(239, 68, 68, .18);
        color: white;
        transform: translateY(-2px);
        border-color: rgba(239, 68, 68, .4);
    }

    /* RESPONSIVE */

    @@media(max-width: 768px) {

        .watch-header {
            align-items: flex-start;
        }

        .video-preview {
            height: 200px;
        }

        .video-actions {
            flex-direction: column;
        }

        .btn-modern {
            width: 100%;
        }
    }

    .btn-modern {
        flex: 1;
        min-width: 120px;
        border-radius: 16px;
        padding: 11px 16px;
        font-size: 13px;
        font-weight: 700;
        transition: .25s ease;
        border: none;

        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
</style>

<div class="container py-4 watch-page">

    <!-- HEADER -->

    <div class="watch-header">

        <div>

            <div class="watch-title">
                ⏳ Daha Sonra İzle
            </div>

            <div class="watch-subtitle">
                Daha sonra izlemek için kaydettiğin videolar burada listelenir.
                İstediğin zaman kaldığın yerden devam edebilirsin.
            </div>

        </div>

        <div class="watch-counter">
            <strong>@Model.Count</strong>
            <span>Kayıtlı Video</span>
        </div>

    </div>

    @if (!Model.Any())
    {
        <!-- EMPTY -->

        <div class="empty-box">

            <div class="empty-icon">
                📌
            </div>

            <h3>Listen şu an boş</h3>

            <p>
                Beğendiğin videoları kaydederek burada saklayabilirsin.
            </p>

            <a asp-controller="Home" asp-action="Index" class="discover-btn">

                🚀 Videoları Keşfet

            </a>

        </div>
    }
    else
    {
        <!-- VIDEOS -->

        <div class="row g-4">

            @foreach (var video in Model)
            {
                <div class="col-xxl-3 col-xl-4 col-md-6">

                    <div class="video-card">

                        <!-- BADGE -->

                        <div class="saved-badge">
                            <span class="saved-dot"></span>
                            KAYDEDİLDİ
                        </div>

                        <!-- VIDEO -->

                        <div class="video-preview">

                            <video class="video-img" muted preload="metadata">
                                <source src="@video.VideoUrl" type="video/mp4" />
                            </video>

                            <div class="video-overlay">

                                <div class="play-btn">
                                    ▶
                                </div>

                            </div>

                        </div>

                        <!-- CONTENT -->

                        <div class="video-content">

                            <div class="video-title">
                                @video.Baslik
                            </div>

                            <div class="video-description">
                                @video.Aciklama
                            </div>

                            <div class="video-stats">

                                <div class="stat-chip">
                                    👁 @video.IzlenmeSayisi İzlenme
                                </div>

                                <div class="stat-chip">
                                    👍 @video.LikeSayisi Beğeni
                                </div>

                                <div class="stat-chip">
                                    📅 @video.YuklenmeTarihi.ToString("dd MMM yyyy")
                                </div>

                            </div>

                            <!-- ACTIONS -->

                            <div class="video-actions">

                                <a asp-controller="Home" asp-action="Izle" asp-route-id="@video.Id"
                                       class="btn-modern btn-watch">

                                    <span>▶</span>
                                    <span>İzle</span>

                                </a>

                                <form asp-controller="Home" asp-action="DahaSonraSil" asp-route-id="@video.Id" method="post"
                                      class="flex-grow-1">

                                    <button type="submit" class="btn-modern btn-remove w-100">

                                        <span>❌</span>
                                        <span>Kaldır</span>

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>