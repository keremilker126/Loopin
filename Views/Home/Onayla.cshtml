@{
    ViewBag.Title = "E-posta Onayı";
}

<style>

    :root{
        --purple:#7c5cff;
        --purple2:#b14dff;
        --success:#22c55e;
        --danger:#ef4444;
    }

    body {

        min-height:100vh;
        margin:0;
        overflow:hidden;

        background:
            radial-gradient(circle at top left, rgba(124,92,255,0.22), transparent 30%),
            radial-gradient(circle at bottom right, rgba(177,77,255,0.18), transparent 30%),
            linear-gradient(160deg, #05050c, #0d0e1c 55%, #090912);

        font-family:'Inter',sans-serif;
        position:relative;
    }

    body::before{
        content:"";
        position:fixed;
        inset:0;

        background-image:
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);

        background-size:40px 40px;

        pointer-events:none;
    }

    body::after{
        content:"";
        position:fixed;

        width:500px;
        height:500px;

        background:radial-gradient(circle,
            rgba(124,92,255,0.18),
            transparent 70%);

        top:-180px;
        right:-120px;

        filter:blur(30px);

        pointer-events:none;
    }

    .verify-wrapper {

        display:flex;
        justify-content:center;
        align-items:flex-start;

        min-height:100vh;

        padding-top:110px;
        padding-inline:20px;

        position:relative;
        z-index:2;
    }

    .verify-box {

        width:100%;
        max-width:460px;

        position:relative;
        overflow:hidden;

        padding:42px 36px;

        border-radius:34px;

        background:
            linear-gradient(
                145deg,
                rgba(255,255,255,0.08),
                rgba(255,255,255,0.03)
            );

        backdrop-filter:blur(28px);

        border:1px solid rgba(255,255,255,0.08);

        box-shadow:
            0 30px 70px rgba(0,0,0,0.45),
            0 0 45px rgba(124,92,255,0.12);

        text-align:center;

        color:white;

        animation:fadeUp .6s ease;
    }

    .verify-box::before{
        content:"";
        position:absolute;
        inset:0;

        background:
            linear-gradient(
                135deg,
                rgba(124,92,255,0.10),
                transparent 35%,
                rgba(177,77,255,0.08)
            );

        pointer-events:none;
    }

    @@keyframes fadeUp{

        from{
            opacity:0;
            transform:translateY(25px);
        }

        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .status-ring{

        width:110px;
        height:110px;

        margin:0 auto 24px;

        border-radius:32px;

        display:flex;
        align-items:center;
        justify-content:center;

        position:relative;

        backdrop-filter:blur(10px);

        animation:floaty 3s ease-in-out infinite;
    }

    @@keyframes floaty{

        0%{
            transform:translateY(0px);
        }

        50%{
            transform:translateY(-6px);
        }

        100%{
            transform:translateY(0px);
        }
    }

    .status-ring.success{
        background:
            linear-gradient(
                135deg,
                rgba(34,197,94,0.22),
                rgba(34,197,94,0.08)
            );

        border:1px solid rgba(34,197,94,0.25);

        box-shadow:
            0 0 35px rgba(34,197,94,0.18);
    }

    .status-ring.error{
        background:
            linear-gradient(
                135deg,
                rgba(239,68,68,0.20),
                rgba(239,68,68,0.08)
            );

        border:1px solid rgba(239,68,68,0.25);

        box-shadow:
            0 0 35px rgba(239,68,68,0.18);
    }

    .icon {

        font-size:52px;
        line-height:1;
    }

    .success {
        color: #4ade80;
    }

    .error {
        color: #f87171;
    }

    .title {

        font-size:30px;

        font-weight:800;

        letter-spacing:-1px;

        margin-bottom:14px;

        background:linear-gradient(90deg,#ffffff,#d7ccff);

        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .desc {

        font-size:14px;

        color:#b9b9d4;

        line-height:1.8;

        margin-bottom:30px;

        max-width:320px;

        margin-inline:auto;
    }

    .btn-back {

        border:none;

        border-radius:999px;

        padding:14px 28px;

        background:
            linear-gradient(
                135deg,
                var(--purple),
                var(--purple2)
            );

        color:white;

        text-decoration:none;

        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:10px;

        font-weight:700;

        font-size:14px;

        transition:.3s ease;

        box-shadow:
            0 14px 35px rgba(124,92,255,0.35);

        position:relative;
        overflow:hidden;
    }

    .btn-back::before{
        content:"";
        position:absolute;
        inset:0;

        background:
            linear-gradient(
                120deg,
                transparent,
                rgba(255,255,255,0.18),
                transparent
            );

        transform:translateX(-100%);
        transition:.6s;
    }

    .btn-back:hover::before{
        transform:translateX(100%);
    }

    .btn-back:hover {

        transform:translateY(-4px) scale(1.03);

        box-shadow:
            0 20px 45px rgba(124,92,255,0.45);

        color:white;
    }

    .mini-glow{
        position:absolute;
        width:180px;
        height:180px;

        border-radius:50%;

        background:
            radial-gradient(circle,
                rgba(124,92,255,0.16),
                transparent 70%);

        filter:blur(25px);

        pointer-events:none;
    }

    .glow-1{
        top:-60px;
        left:-60px;
    }

    .glow-2{
        bottom:-80px;
        right:-60px;
    }

    @@media(max-width:576px){

        .verify-wrapper{
            padding-top:70px;
        }

        .verify-box{
            padding:34px 24px;
            border-radius:28px;
        }

        .title{
            font-size:24px;
        }

        .status-ring{
            width:95px;
            height:95px;
        }

        .icon{
            font-size:46px;
        }

    }

</style>

<div class="verify-wrapper">

    <div class="verify-box">

        <div class="mini-glow glow-1"></div>
        <div class="mini-glow glow-2"></div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="status-ring success">
                <div class="icon success">✅</div>
            </div>

            <div class="title">
                E-posta Doğrulandı
            </div>

            <div class="desc">
                @ViewBag.SuccessMessage
            </div>

            <a href="/Home/Giris" class="btn-back">
                🚀 Giriş Yap
            </a>
        }
        else
        {
            <div class="status-ring error">
                <div class="icon error">❌</div>
            </div>

            <div class="title">
                Onay Başarısız
            </div>

            <div class="desc">
                Doğrulama işlemi başarısız oldu veya bağlantının süresi doldu.
            </div>

            <a href="/Home/Kayit" class="btn-back">
                📝 Tekrar Kayıt Ol
            </a>
        }

    </div>

</div>