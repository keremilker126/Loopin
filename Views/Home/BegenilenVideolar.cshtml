@model List<Loopin.Models.Video>

@{
    ViewData["Title"] = "Beğendiklerim";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<style>

    :root{
        --pink:#ff4fd8;
        --purple:#8b5cf6;
        --purple2:#6d28d9;
        --bg:#080811;
        --card:rgba(255,255,255,0.05);
        --border:rgba(255,255,255,0.08);
        --text:#ffffff;
        --muted:#9ca3af;
    }

    /* PAGE */

    .liked-page{
        position:relative;
        overflow:hidden;
        animation:fadeIn .45s ease;
    }

    @@keyframes fadeIn{
        from{
            opacity:0;
            transform:translateY(12px);
        }

        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .liked-page::before{
        content:"";
        position:fixed;
        width:700px;
        height:700px;
        top:-220px;
        right:-220px;

        background:
            radial-gradient(rgba(255,79,216,0.12),
            transparent 70%);

        pointer-events:none;
    }

    .liked-page::after{
        content:"";
        position:fixed;
        width:650px;
        height:650px;
        bottom:-220px;
        left:-220px;

        background:
            radial-gradient(rgba(139,92,246,0.12),
            transparent 70%);

        pointer-events:none;
    }

    /* HERO */

    .liked-hero{
        position:relative;
        overflow:hidden;

        padding:42px;

        border-radius:36px;

        margin-bottom:38px;

        background:
            radial-gradient(circle at top left,
            rgba(255,79,216,0.16),
            transparent 35%),

            radial-gradient(circle at bottom right,
            rgba(139,92,246,0.18),
            transparent 35%),

            rgba(255,255,255,0.05);

        border:1px solid rgba(255,255,255,0.08);

        backdrop-filter:blur(24px);

        box-shadow:
            0 25px 60px rgba(0,0,0,0.35),
            inset 0 1px 0 rgba(255,255,255,0.03);
    }

    .hero-badge{
        display:inline-flex;
        align-items:center;
        gap:10px;

        padding:10px 18px;

        border-radius:999px;

        background:rgba(255,255,255,0.06);

        border:1px solid rgba(255,255,255,0.08);

        color:#f5d0fe;

        font-size:13px;
        font-weight:700;

        margin-bottom:18px;
    }

    .hero-title{
        font-size:52px;
        font-weight:900;
        line-height:1.05;

        margin-bottom:14px;

        letter-spacing:-1px;
    }

    .hero-title span{
        background:
            linear-gradient(135deg,
            #ffffff,
            #f9a8d4,
            #a855f7);

        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .hero-subtitle{
        max-width:700px;

        color:var(--muted);

        line-height:1.8;

        font-size:15px;
    }

    /* HEADER */

    .section-header{
        display:flex;
        justify-content:space-between;
        align-items:center;

        gap:20px;

        margin-bottom:30px;

        flex-wrap:wrap;
    }

    .section-title{
        font-size:30px;
        font-weight:800;

        display:flex;
        align-items:center;
        gap:12px;
    }

    .section-title i{
        color:#ff4fd8;
    }

    .section-subtitle{
        margin-top:5px;
        color:var(--muted);
        font-size:14px;
    }

    /* GRID */

    .videos-grid{
        display:grid;
        grid-template-columns:
            repeat(auto-fill,minmax(320px,1fr));

        gap:28px;
    }

    /* CARD */

    .video-card-modern{
        position:relative;
        overflow:hidden;

        border-radius:30px;

        background:rgba(255,255,255,0.05);

        border:1px solid rgba(255,255,255,0.08);

        backdrop-filter:blur(24px);

        transition:.35s ease;

        box-shadow:
            0 18px 40px rgba(0,0,0,0.28);
    }

    .video-card-modern:hover{
        transform:translateY(-10px);

        border-color:rgba(255,79,216,0.35);

        box-shadow:
            0 35px 70px rgba(0,0,0,0.5),
            0 0 40px rgba(255,79,216,0.14);
    }

    /* VIDEO */

    .video-preview-wrapper{
        position:relative;
        overflow:hidden;
        height:220px;
    }

    .video-preview{
        width:100%;
        height:100%;
        object-fit:cover;

        transition:.5s ease;

        background:black;
    }

    .video-card-modern:hover .video-preview{
        transform:scale(1.08);
    }

    /* OVERLAY */

    .video-overlay{
        position:absolute;
        inset:0;

        background:
            linear-gradient(to top,
            rgba(0,0,0,0.78),
            rgba(0,0,0,0.08));

        display:flex;
        justify-content:center;
        align-items:center;

        opacity:0;
        transition:.3s ease;
    }

    .video-card-modern:hover .video-overlay{
        opacity:1;
    }

    .play-btn{
        width:84px;
        height:84px;

        border-radius:50%;

        display:flex;
        align-items:center;
        justify-content:center;

        background:rgba(255,255,255,0.14);

        border:1px solid rgba(255,255,255,0.18);

        backdrop-filter:blur(14px);

        color:white;

        font-size:28px;

        transition:.3s ease;
    }

    .video-card-modern:hover .play-btn{
        transform:scale(1.08);
    }

    /* BADGES */

    .card-top{
        position:absolute;

        top:14px;
        left:14px;
        right:14px;

        display:flex;
        justify-content:space-between;

        z-index:5;
    }

    .card-badge{
        padding:8px 14px;

        border-radius:999px;

        font-size:11px;
        font-weight:800;

        backdrop-filter:blur(10px);

        border:1px solid rgba(255,255,255,0.08);
    }

    .badge-liked{
        background:
            linear-gradient(135deg,
            #ff4fd8,
            #8b5cf6);

        color:white;

        box-shadow:
            0 12px 25px rgba(255,79,216,0.28);
    }

    .badge-stats{
        background:rgba(0,0,0,0.4);
        color:white;
    }

    /* CONTENT */

    .video-content{
        padding:24px;
    }

    .video-title{
        font-size:20px;
        font-weight:800;
        line-height:1.4;

        margin-bottom:10px;
    }

    .video-desc{
        color:var(--muted);

        font-size:14px;

        line-height:1.7;

        height:48px;

        overflow:hidden;

        margin-bottom:22px;
    }

    /* META */

    .video-meta{
        display:flex;
        justify-content:space-between;
        align-items:center;

        gap:14px;

        margin-bottom:24px;

        flex-wrap:wrap;
    }

    .meta-user{
        display:flex;
        align-items:center;
        gap:12px;
    }

    .meta-avatar{
        width:48px;
        height:48px;

        border-radius:16px;

        background:
            linear-gradient(135deg,
            var(--pink),
            var(--purple));

        display:flex;
        align-items:center;
        justify-content:center;

        color:white;

        font-size:18px;

        box-shadow:
            0 12px 28px rgba(255,79,216,0.28);
    }

    .meta-title{
        font-size:13px;
        color:#ececff;
        font-weight:700;
    }

    .meta-sub{
        font-size:12px;
        color:#8f94aa;
    }

    .stats{
        display:flex;
        align-items:center;
        gap:12px;

        font-size:13px;
        color:#d7dae7;
    }

    /* BUTTONS */

    .action-buttons{
        display:flex;
        gap:12px;
        flex-wrap:wrap;
    }

    .btn-modern{
        border:none;

        border-radius:18px;

        padding:14px 18px;

        font-size:13px;
        font-weight:700;

        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;

        transition:.25s ease;

        text-decoration:none;
    }

    .btn-watch{
        flex:1;

        background:
            linear-gradient(135deg,
            var(--pink),
            var(--purple));

        color:white;

        box-shadow:
            0 15px 35px rgba(255,79,216,0.28);
    }

    .btn-watch:hover{
        transform:translateY(-2px);

        color:white;

        box-shadow:
            0 20px 40px rgba(255,79,216,0.4);
    }

    .btn-save{
        background:rgba(250,204,21,0.12);

        border:1px solid rgba(250,204,21,0.18);

        color:#fde68a;
    }

    .btn-save:hover{
        transform:translateY(-2px);
        background:rgba(250,204,21,0.18);
    }

    .btn-remove{
        background:rgba(239,68,68,0.12);

        border:1px solid rgba(239,68,68,0.18);

        color:#fca5a5;
    }

    .btn-remove:hover{
        transform:translateY(-2px);
        background:rgba(239,68,68,0.18);
    }

    /* EMPTY */

    .empty-wrapper{
        min-height:65vh;

        display:flex;
        justify-content:center;
        align-items:center;
    }

    .empty-box{
        width:100%;
        max-width:760px;

        text-align:center;

        padding:60px;

        border-radius:38px;

        background:rgba(255,255,255,0.05);

        border:1px solid rgba(255,255,255,0.08);

        backdrop-filter:blur(24px);

        box-shadow:
            0 25px 60px rgba(0,0,0,0.35);
    }

    .empty-icon{
        width:120px;
        height:120px;

        border-radius:30px;

        margin:auto;
        margin-bottom:28px;

        display:flex;
        align-items:center;
        justify-content:center;

        background:
            linear-gradient(135deg,
            #ff4fd8,
            #8b5cf6);

        color:white;

        font-size:48px;

        box-shadow:
            0 25px 50px rgba(255,79,216,0.35);
    }

    .empty-title{
        font-size:38px;
        font-weight:900;

        margin-bottom:12px;

        background:
            linear-gradient(135deg,
            #ffffff,
            #f9a8d4,
            #a855f7);

        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .empty-text{
        color:var(--muted);

        line-height:1.8;

        max-width:520px;

        margin:auto;
    }

    /* MOBILE */

    @@media(max-width:768px){

        .liked-hero{
            padding:28px;
            border-radius:28px;
        }

        .hero-title{
            font-size:38px;
        }

        .videos-grid{
            grid-template-columns:1fr;
        }

        .action-buttons{
            flex-direction:column;
        }

        .btn-watch,
        .btn-save,
        .btn-remove{
            width:100%;
        }

        .empty-box{
            padding:40px 24px;
        }
    }

</style>

<div class="liked-page">

    <!-- HERO -->
    <div class="liked-hero">

        <div class="hero-badge">
            <i class="fa-solid fa-heart"></i>
            Favori Koleksiyonun
        </div>

        <div class="hero-title">
            Beğendiğin <span>Videolar</span>
        </div>

        <div class="hero-subtitle">
            Sevdiğin içerikleri tek yerde sakla, tekrar izle ve daha sonra eriş.
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="empty-wrapper">

            <div class="empty-box">

                <div class="empty-icon">
                    <i class="fa-solid fa-heart"></i>
                </div>

                <div class="empty-title">
                    Henüz Beğeni Yok
                </div>

                <div class="empty-text">
                    Videoları izlerken 👍 butonuna basarak favorilerine ekleyebilirsin.
                </div>

            </div>

        </div>
    }
    else
    {

        <!-- HEADER -->
        <div class="section-header">

            <div>

                <div class="section-title">
                    <i class="fa-solid fa-heart-circle-check"></i>
                    Favori Videoların
                </div>

                <div class="section-subtitle">
                    Toplam @Model.Count video beğendin
                </div>

            </div>

        </div>

        <!-- GRID -->
        <div class="videos-grid">

            @foreach (var video in Model)
            {
                <div class="video-card-modern">

                    <!-- VIDEO -->
                    <div class="video-preview-wrapper">

                        <!-- BADGES -->
                        <div class="card-top">

                            <div class="card-badge badge-liked">
                                ❤️ FAVORİ
                            </div>

                            <div class="card-badge badge-stats">
                                👁 @video.IzlenmeSayisi
                            </div>

                        </div>

                        <!-- VIDEO -->
                        <video class="video-preview"
                               muted
                               preload="metadata">

                            <source src="@video.VideoUrl"
                                    type="video/mp4" />

                        </video>

                        <!-- OVERLAY -->
                        <div class="video-overlay">

                            <div class="play-btn">
                                <i class="fa-solid fa-play"></i>
                            </div>

                        </div>

                    </div>

                    <!-- CONTENT -->
                    <div class="video-content">

                        <div class="video-title">
                            @video.Baslik
                        </div>

                        <div class="video-desc">
                            @video.Aciklama
                        </div>

                        <!-- META -->
                        <div class="video-meta">

                            <div class="meta-user">

                                <div class="meta-avatar">
                                    <i class="fa-solid fa-user"></i>
                                </div>

                                <div>

                                    <div class="meta-title">
                                        @video.Kullanici?.KullaniciAdi
                                    </div>

                                    <div class="meta-sub">
                                        @video.YuklenmeTarihi.ToString("dd MMM yyyy")
                                    </div>

                                </div>

                            </div>

                            <div class="stats">
                                <span>👍 @video.LikeSayisi</span>
                            </div>

                        </div>

                        <!-- BUTTONS -->
                        <div class="action-buttons">

                            <!-- WATCH -->
                            <a asp-controller="Home"
                               asp-action="Izle"
                               asp-route-id="@video.Id"
                               class="btn-modern btn-watch">

                                <i class="fa-solid fa-play"></i>
                                İzle

                            </a>

                            <!-- SAVE -->
                            <form asp-controller="Home"
                                  asp-action="DahaSonraEkle"
                                  asp-route-id="@video.Id"
                                  method="post">

                                <button class="btn-modern btn-save">

                                    <i class="fa-solid fa-clock"></i>
                                    Kaydet

                                </button>

                            </form>

                            <!-- REMOVE -->
                            <form asp-controller="Home"
                                  asp-action="BegenilerdenKaldir"
                                  asp-route-id="@video.Id"
                                  method="post">

                                <button class="btn-modern btn-remove">

                                    <i class="fa-solid fa-heart-crack"></i>
                                    Kaldır

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>